---
import Layout from "../layouts/Layout.astro";

const logos = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => `/logos/logo-0${n}.png`);

// Placeholder phrase — final wording is a founder authoring decision per
// the U10 hard copy gate. The phrase repeats as a section divider; two
// mandatory occurrences (after hero, after founder), an optional third
// before contact.
const KINETIC_PHRASE = "Decisions, not slides.";

const methodBlocks = [
  {
    eyebrow: "01 · Assessment",
    heading: "Diagnose what's actually moving the number.",
    prose:
      "Operator-grade assessment of churn drivers, journey leakage, pricing leaks, and AI-program maturity. Map the current state, define measurable success criteria, and surface the decisions that will compound.",
  },
  {
    eyebrow: "02 · Strategy & architecture",
    heading: "Decisions, not slides.",
    prose:
      "Operating models, decision rights, and architecture direction written as artifacts your teams execute against. Direction is sharper, scope is bounded, and the next 90 days are concrete.",
  },
  {
    eyebrow: "03 · Roadmap",
    heading: "A 90-day plan that survives delivery.",
    prose:
      "Sequenced workstreams, named owners, and exec-ready milestones — written so leadership can govern and engineering can ship without a re-litigation cycle every two weeks.",
  },
  {
    eyebrow: "04 · Measurement & governance",
    heading: "Metrics leaders can act on.",
    prose:
      "Leading indicators, model evaluation frameworks, and a governance cadence that keeps teams accountable and surfaces whether the work is moving the business — not just shipping features.",
  },
];

const faqs = [
  {
    id: 1,
    q: "What do I get in the first 2 weeks?",
    a: "A tight problem definition, current-state map, measurable success criteria, and a scoped 90-day plan that your teams can execute.",
  },
  {
    id: 2,
    q: "Do you implement systems or code?",
    a: "No. We advise only. We define strategy, architecture direction, requirements, and decision frameworks your teams or partners execute.",
  },
  {
    id: 3,
    q: "Can you sign an NDA before we talk?",
    a: "Yes. We're comfortable operating inside regulated environments and with strict confidentiality.",
  },
  {
    id: 4,
    q: "What does an engagement actually include?",
    a: "Assessments, executive workshops, architecture reviews, roadmaps, and written action plans. No build or delivery ownership.",
  },
  {
    id: 5,
    q: "How do you measure impact?",
    a: "We define leading indicators and business outcomes up front, instrument journeys, and set a review cadence that keeps teams accountable.",
  },
];
---

<Layout>
  <main id="main">
    <section class="hero" aria-label="Hero">
      <div class="container">
        <p class="eyebrow">AI · Data · Customer Growth</p>
        <h1 class="display">Turn AI, data, and customers into a durable growth system.</h1>
        <p class="lede">
          Independent executive advisory on operating models, platforms, and decisions that compound lifetime value.
        </p>

        <div class="actions">
          <a class="btn btn-primary" href="#contact">Schedule a discovery meeting</a>
          <a class="btn btn-secondary" href="#outcomes">Discover how we work</a>
        </div>

        <div class="trust-pills" aria-label="Trust signals">
          <span class="btn btn-ghost" role="note">Your vision, our expertise</span>
          <span class="btn btn-ghost" role="note">Confidential &amp; secure — NDA friendly</span>
          <span class="btn btn-ghost" role="note">Senior operators at work</span>
        </div>

        <p class="micro" style="margin-top: 28px;">
          Trusted by teams across telco, banking, and SaaS.
        </p>

        <div class="logo-grid" id="experience" aria-label="Experience logos">
          {
            logos.map((src, i) => (
              <div class="logo-tile">
                <img src={src} alt={`Client logo ${i + 1}`} loading="lazy" decoding="async" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="kinetic-phrase" aria-hidden="true">
      <div class="kinetic-phrase-track">
        <span>{KINETIC_PHRASE}&nbsp;&nbsp;</span>
        <span>{KINETIC_PHRASE}&nbsp;&nbsp;</span>
      </div>
    </div>

    <section class="section" id="method" aria-label="How we work">
      <div class="container">
        <div class="section-head">
          <p class="section-label">How we work</p>
          <h2 class="display">Four moves that turn AI and customer programs into compounding growth.</h2>
        </div>

        {
          methodBlocks.map((b) => (
            <article class="method-block">
              <div class="method-content">
                <p class="eyebrow">{b.eyebrow}</p>
                <h2>{b.heading}</h2>
                <p>{b.prose}</p>
              </div>
              <div class="method-placeholder" aria-hidden="true"></div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="founder-section" id="founder" aria-label="Founder">
      <div class="container">
        <div class="section-head">
          <p class="section-label">The founder</p>
        </div>

        <div class="founder-grid">
          <figure class="founder-photo">
            <div class="tonal-placeholder square" aria-hidden="true"></div>
            <figcaption>Founder</figcaption>
          </figure>

          <div class="founder-bio">
            <p>
              Two paragraphs introducing the founder — prior operator roles in regulated industries (telco, banking, insurance, SaaS), the specific shape of work delivered there, and the through-line that informs how Capita runs engagements today.
            </p>
            <p>
              A second paragraph naming the founder's view on what's actually shifting in AI-powered customer programs right now, and the kind of leadership team Capita helps best. Founder authors the final copy before ship.
            </p>

            <p class="founder-signed">
              We measure what matters.
              <span class="founder-signed-name">— Founder Name</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="kinetic-phrase" aria-hidden="true">
      <div class="kinetic-phrase-track">
        <span>{KINETIC_PHRASE}&nbsp;&nbsp;</span>
        <span>{KINETIC_PHRASE}&nbsp;&nbsp;</span>
      </div>
    </div>

    <section class="section" id="outcomes" aria-label="Outcomes">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Outcomes</p>
          <h2 class="display">Clarity that only ex-operators can deliver.</h2>
          <p class="lede">90-day strategies, roadmaps, and exec-ready decision artifacts.</p>
        </div>

        <div class="outcome-grid">
          <article class="outcome-card">
            <h3>Retention lift</h3>
            <p>Diagnose churn drivers. Define interventions. Specify measurement and ownership.</p>
          </article>
          <article class="outcome-card">
            <h3>Revenue protection</h3>
            <p>Pricing, eligibility, friction, and service failures. Quantify, prioritise, and roadmap.</p>
          </article>
          <article class="outcome-card">
            <h3>AI that performs</h3>
            <p>Model evaluation frameworks, governance, and operating cadence recommendations.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="faq" aria-label="Frequently asked questions">
      <div class="container">
        <div class="section-head">
          <p class="section-label">FAQ</p>
          <h2 class="display">Frequently asked questions</h2>
          <p class="lede">Common questions answered.</p>
        </div>

        <div class="faq-grid">
          <div class="faq-stack">
            {
              faqs.map((f) => (
                <article class="faq-card">
                  <button
                    class="faq-q"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`faq-a${f.id}`}
                    id={`faq-q${f.id}`}
                  >
                    {f.q}
                  </button>
                  <div class="faq-a" id={`faq-a${f.id}`} role="region" aria-labelledby={`faq-q${f.id}`} hidden>
                    <p>{f.a}</p>
                  </div>
                </article>
              ))
            }
          </div>

          <aside class="tile faq-aside" aria-label="What we offer">
            <h3>What we offer</h3>
            <p>To earn your trust, and keep it.</p>
            <ul>
              <li><strong>Risk-managed start</strong> — small scope before scaling.</li>
              <li><strong>Transparent cadence</strong> — weekly demos and clear artifacts.</li>
              <li><strong>NDA-first</strong> — confidentiality and security by default.</li>
              <li><strong>Working principles</strong> — define direction and enable execution.</li>
              <li><strong>Exec-ready measurement</strong> — metrics leaders govern.</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="section" id="contact" aria-label="Contact">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Start the conversation</p>
          <h2 class="display">Share the context.</h2>
          <p class="lede">Send the context. We respond with advisory next steps.</p>
        </div>

        <div class="contact-grid">
          <form id="leadForm" novalidate>
            {/* Honeypot — hidden offscreen, populated honeypot aborts submission. */}
            <div style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
              <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="field-row">
              <label class="field-label">
                <span class="micro">Name (required)</span>
                <input
                  id="name"
                  name="name"
                  class="field-input"
                  required
                  autocomplete="name"
                  inputmode="text"
                  maxlength="60"
                  placeholder="Jane Smith"
                  pattern="^[A-Za-zÀ-ÖØ-öø-ÿ'’ -]{2,60}$"
                />
              </label>

              <label class="field-label">
                <span class="micro">Email (required)</span>
                <input
                  id="email"
                  name="email"
                  type="email"
                  class="field-input"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="jane@company.com"
                />
              </label>
            </div>

            <div class="field-row">
              <div>
                <span class="micro">Country code</span>
                <div class="cc-wrap" style="margin-top: 8px;">
                  <input
                    id="ccSearch"
                    name="ccSearch"
                    class="field-input"
                    role="combobox"
                    aria-expanded="false"
                    aria-controls="ccList"
                    aria-autocomplete="list"
                    autocomplete="off"
                    inputmode="search"
                    placeholder="Type to search (e.g., Australia, AUS, +61)"
                  />
                  <div id="ccList" class="cc-list" role="listbox" aria-label="Country codes">
                    <div class="micro" style="margin: 0 0 8px;">Select a country code</div>
                    <div id="ccOptions" class="cc-options"></div>
                  </div>
                  <input type="hidden" id="ccDial" name="ccDial" value="+61" />
                  <input type="hidden" id="ccISO3" name="ccISO3" value="AUS" />
                  <input type="hidden" id="ccISO2" name="ccISO2" value="AU" />
                </div>
                <p class="micro" style="margin-top: 8px;">Type-ahead supported. Defaults to Australia (+61).</p>
              </div>

              <label class="field-label">
                <span class="micro">Phone (optional)</span>
                <input
                  id="phone"
                  name="phone"
                  class="field-input"
                  autocomplete="tel-national"
                  inputmode="tel"
                  maxlength="24"
                  placeholder="412 345 678"
                  pattern={"^[0-9()\\-\\s]{0,24}$"}
                />
                <p class="micro" style="margin-top: 8px;">Digits only; spaces and dashes allowed.</p>
              </label>
            </div>

            <div class="field-row single">
              <label class="field-label">
                <span class="micro">What's on your mind? (optional)</span>
                <textarea
                  id="message"
                  name="message"
                  class="field-textarea"
                  rows="5"
                  maxlength="2000"
                  placeholder="Tell us about the outcome you want to move in the next 90 days."></textarea>
              </label>
            </div>

            <div id="formError" class="micro" style="margin-top: 12px;"></div>
            <div id="formSuccess" class="lede" style="margin-top: 12px;" role="status" aria-live="polite"></div>

            <div class="actions" style="margin-top: 16px;">
              <button class="btn btn-primary" type="submit">Send enquiry</button>
            </div>
          </form>

          <aside class="tile" aria-label="What we understand">
            <h3>What we'll help you fix</h3>
            <p>Common pain points we see in customer and AI programmes.</p>
            <ul style="margin: 14px 0 0 0; padding-left: 20px; color: var(--muted);">
              <li style="margin: 8px 0;">Fragmented ownership across product, data, and channels</li>
              <li style="margin: 8px 0;">Strategies defined without clear measurement or accountability</li>
              <li style="margin: 8px 0;">Weak measurement and unclear decision rights</li>
              <li style="margin: 8px 0;">Journey leakage nobody can quantify</li>
              <li style="margin: 8px 0;">Roadmaps that don't survive delivery reality</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </main>
</Layout>
