---
import Layout from "../layouts/Layout.astro";

const logos = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => `/logos/logo-0${n}.png`);

// Founder section is hidden behind this flag until real bio + photo + signed
// line all land per the U6 hard copy gate. Flip to `true` when copy is ready.
const SHOW_FOUNDER = false;

// Recurring kinetic phrase — placeholder copy. Final wording is a founder
// authoring decision per the U10 hard copy gate. Currently neutral structural
// copy that doesn't land the anti-PowerPoint snark of earlier placeholders.
const KINETIC_PHRASE = "Operator-grade clarity.";

const methodBlocks = [
  {
    number: "01",
    eyebrow: "Assessment",
    heading: "Diagnose what's actually moving the number.",
    prose:
      "Operator-grade assessment of churn drivers, journey leakage, pricing leaks, and AI-program maturity. Map the current state, define measurable success criteria, and surface the decisions that will compound.",
  },
  {
    number: "02",
    eyebrow: "Strategy & architecture",
    heading: "Direction your teams can execute against.",
    prose:
      "Operating models, decision rights, and architecture direction written as artifacts your teams execute against. Direction is sharper, scope is bounded, and the next 90 days are concrete.",
  },
  {
    number: "03",
    eyebrow: "Roadmap",
    heading: "A 90-day plan that survives delivery.",
    prose:
      "Sequenced workstreams, named owners, and exec-ready milestones — written so leadership can govern and engineering can ship without a re-litigation cycle every two weeks.",
  },
  {
    number: "04",
    eyebrow: "Measurement & governance",
    heading: "Metrics leaders can act on.",
    prose:
      "Leading indicators, model evaluation frameworks, and a governance cadence that keeps teams accountable and surfaces whether the work is moving the business — not just shipping features.",
  },
];

const outcomes = [
  {
    number: "I",
    label: "Retention",
    heading: "Retention lift.",
    prose: "Diagnose churn drivers. Define interventions. Specify measurement and ownership.",
  },
  {
    number: "II",
    label: "Revenue",
    heading: "Revenue protection.",
    prose: "Pricing, eligibility, friction, and service failures. Quantify, prioritise, and roadmap.",
  },
  {
    number: "III",
    label: "AI",
    heading: "AI that performs.",
    prose: "Model evaluation frameworks, governance, and operating cadence recommendations.",
  },
];

const faqs = [
  {
    id: 1,
    q: "What do I get in the first 2 weeks?",
    a: "A tight problem definition, current-state map, measurable success criteria, and a scoped 90-day plan that your teams can execute.",
  },
  {
    id: 2,
    q: "Do you implement systems or code?",
    a: "No. We advise only. We define strategy, architecture direction, requirements, and decision frameworks your teams or partners execute.",
  },
  {
    id: 3,
    q: "Can you sign an NDA before we talk?",
    a: "Yes. We're comfortable operating inside regulated environments and with strict confidentiality.",
  },
  {
    id: 4,
    q: "What does an engagement actually include?",
    a: "Assessments, executive workshops, architecture reviews, roadmaps, and written action plans. No build or delivery ownership.",
  },
  {
    id: 5,
    q: "How do you measure impact?",
    a: "We define leading indicators and business outcomes up front, instrument journeys, and set a review cadence that keeps teams accountable.",
  },
];
---

<Layout>
  <main id="main">
    <section class="hero" aria-label="Hero">
      <div class="container">
        <p class="eyebrow">AI · Data · Customer Growth</p>
        <h1 class="display">Turn AI, data, and customers into a <mark class="why-mark">durable</mark> growth system.</h1>
        <p class="lede">
          Independent executive advisory on operating models, platforms, and decisions that compound lifetime value.
        </p>

        <div class="actions">
          <a class="btn btn-primary" href="#contact">Request a working session</a>
          <a class="btn btn-secondary" href="#method">Read the method</a>
        </div>
      </div>
    </section>

    {/* Sentinel for the body.grid-calm toggle. When this scrolls above the
        viewport top, body sections render over the calmed grid tint; when
        it's still visible (user is at/near hero), grid renders at full
        intensity. Observed by the inline script in Layout.astro. */}
    <div id="grid-calm-sentinel" aria-hidden="true" style="height: 1px;"></div>

    <section class="trusted" id="experience" aria-label="Trusted by">
      <div class="container">
        <p class="eyebrow">Trusted by teams across telco, banking, and SaaS</p>
        <div class="logo-grid">
          {
            logos.map((src, i) => (
              <img src={src} alt={`Client logo ${i + 1}`} loading="lazy" decoding="async" />
            ))
          }
        </div>
      </div>
    </section>

    <div class="kinetic-phrase" aria-hidden="true">
      <div class="kinetic-phrase-track">
        <span>{KINETIC_PHRASE}</span>
      </div>
    </div>

    <section class="section" id="method" aria-label="How we work">
      <div class="container">
        <div class="section-head">
          <p class="section-label">How we work</p>
          <h2 class="display">Four moves that turn AI and customer programs into compounding growth.</h2>
        </div>

        {
          methodBlocks.map((b) => (
            <article class="method-block">
              <div class="method-anchor" aria-hidden="true">{b.number}</div>
              <div class="method-content">
                <p class="eyebrow">{b.eyebrow}</p>
                <h3>{b.heading}</h3>
                <p>{b.prose}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {SHOW_FOUNDER && (
      <Fragment>
        <div class="kinetic-phrase" aria-hidden="true">
          <div class="kinetic-phrase-track">
            <span>{KINETIC_PHRASE}</span>
          </div>
        </div>

        <section class="founder-section" id="founder" aria-label="Founder">
          <div class="container">
            <div class="section-head">
              <p class="section-label">The founder</p>
            </div>

            <div class="founder-grid">
              <figure class="founder-photo">
                <div class="tonal-placeholder" aria-hidden="true"></div>
                <figcaption>Founder name</figcaption>
              </figure>

              <div class="founder-bio">
                <p>
                  Founder bio paragraph 1 — placeholder. Awaiting founder copy per the U6 hard gate.
                </p>
                <p>
                  Founder bio paragraph 2 — placeholder. Awaiting founder copy per the U6 hard gate.
                </p>

                <p class="founder-signed">
                  Signed manifesto line — placeholder.
                  <span class="founder-signed-name">— Founder name</span>
                </p>
              </div>
            </div>
          </div>
        </section>
      </Fragment>
    )}

    <section class="section" id="outcomes" aria-label="Outcomes">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Outcomes</p>
          <h2 class="display">Clarity that only ex-operators can deliver.</h2>
          <p class="lede">90-day strategies, roadmaps, and exec-ready decision artifacts.</p>
        </div>

        <div class="outcome-grid">
          {
            outcomes.map((o) => (
              <article class="outcome-col">
                <p class="eyebrow">{o.number} · {o.label}</p>
                <h3>{o.heading}</h3>
                <p>{o.prose}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="faq" aria-label="Frequently asked questions">
      <div class="container">
        <div class="section-head">
          <p class="section-label">FAQ</p>
          <h2 class="display">Questions we hear most often.</h2>
        </div>

        <div class="faq-stack">
          {
            faqs.map((f) => (
              <article class="faq-card">
                <button
                  class="faq-q"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`faq-a${f.id}`}
                  id={`faq-q${f.id}`}
                >
                  {f.q}
                </button>
                <div class="faq-a" id={`faq-a${f.id}`} role="region" aria-labelledby={`faq-q${f.id}`} hidden>
                  <p>{f.a}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="contact" aria-label="Contact">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Start the conversation</p>
          <h2 class="display">Share the context. We respond with advisory next steps.</h2>
        </div>

        <div class="contact-grid">
          <form
            id="leadForm"
            action="https://formspree.io/f/xojdzarv"
            method="post"
            novalidate
          >
            {/* Honeypot — hidden offscreen, populated honeypot aborts submission. */}
            <div style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
              <label>
                Company
                <input type="text" name="company" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="field-row">
              <label class="field-label">
                <span class="micro">Name (required)</span>
                <input
                  id="name"
                  name="name"
                  class="field-input"
                  required
                  autocomplete="name"
                  inputmode="text"
                  maxlength="60"
                  placeholder="Jane Smith"
                />
              </label>

              <label class="field-label">
                <span class="micro">Email (required)</span>
                <input
                  id="email"
                  name="email"
                  type="email"
                  class="field-input"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="jane@company.com"
                />
              </label>
            </div>

            <div class="field-row">
              <div>
                <span class="micro">Country code</span>
                <div class="cc-wrap" style="margin-top: 8px;">
                  <input
                    id="ccSearch"
                    name="ccSearch"
                    class="field-input"
                    role="combobox"
                    aria-expanded="false"
                    aria-controls="ccList"
                    aria-autocomplete="list"
                    autocomplete="off"
                    inputmode="search"
                    placeholder="Australia (+61)"
                  />
                  <div id="ccList" class="cc-list" role="listbox" aria-label="Country codes">
                    <div id="ccOptions" class="cc-options"></div>
                  </div>
                  <input type="hidden" id="ccDial" name="ccDial" value="+61" />
                  <input type="hidden" id="ccISO3" name="ccISO3" value="AUS" />
                  <input type="hidden" id="ccISO2" name="ccISO2" value="AU" />
                </div>
                <p class="micro" style="margin-top: 8px;">Defaults to Australia. Type to search.</p>
              </div>

              <label class="field-label">
                <span class="micro">Phone (optional)</span>
                <input
                  id="phone"
                  name="phone"
                  class="field-input"
                  autocomplete="tel-national"
                  inputmode="tel"
                  maxlength="24"
                  placeholder="412 345 678"
                  pattern={"^[0-9()\\-\\s]{0,24}$"}
                />
              </label>
            </div>

            <div class="field-row single">
              <label class="field-label">
                <span class="micro">What's on your mind? (optional)</span>
                <textarea
                  id="message"
                  name="message"
                  class="field-textarea"
                  rows="5"
                  maxlength="2000"
                  placeholder="Tell us about the outcome you want to move in the next 90 days."></textarea>
              </label>
            </div>

            <div id="formError" class="micro" style="margin-top: 14px;"></div>
            <div id="formSuccess" class="lede" style="margin-top: 14px;" role="status" aria-live="polite"></div>

            <div class="actions" style="margin-top: 24px;">
              <button class="btn btn-primary" type="submit">Send enquiry</button>
            </div>
          </form>

          <aside class="contact-pains" aria-label="What we understand">
            <h3>What we'll help you fix</h3>
            <p>Common pain points we see in customer and AI programmes.</p>
            <ul>
              <li>Fragmented ownership across product, data, and channels</li>
              <li>Strategies defined without clear measurement or accountability</li>
              <li>Weak measurement and unclear decision rights</li>
              <li>Journey leakage nobody can quantify</li>
              <li>Roadmaps that don't survive delivery reality</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </main>
</Layout>
