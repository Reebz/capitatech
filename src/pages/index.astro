---
import Layout from "../layouts/Layout.astro";

const logos = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => `/logos/logo-0${n}.png`);

const methodBlocks = [
  {
    eyebrow: "01 · Assessment",
    heading: "Diagnose what's actually moving the number.",
    prose:
      "Operator-grade assessment of churn drivers, journey leakage, pricing leaks, and AI-program maturity. Map the current state, define measurable success criteria, and surface the decisions that will compound.",
  },
  {
    eyebrow: "02 · Strategy & architecture",
    heading: "Decisions, not slides.",
    prose:
      "Operating models, decision rights, and architecture direction written as artifacts your teams execute against. Direction is sharper, scope is bounded, and the next 90 days are concrete.",
  },
  {
    eyebrow: "03 · Roadmap",
    heading: "A 90-day plan that survives delivery.",
    prose:
      "Sequenced workstreams, named owners, and exec-ready milestones — written so leadership can govern and engineering can ship without a re-litigation cycle every two weeks.",
  },
  {
    eyebrow: "04 · Measurement & governance",
    heading: "Metrics leaders can act on.",
    prose:
      "Leading indicators, model evaluation frameworks, and a governance cadence that keeps teams accountable and surfaces whether the work is moving the business — not just shipping features.",
  },
];
---

<Layout>
  <main id="main">
    <section class="hero" aria-label="Hero">
      <div class="container">
        <p class="eyebrow">AI · Data · Customer Growth</p>
        <h1 class="display">Turn AI, data, and customers into a durable growth system.</h1>
        <p class="lede">
          Independent executive advisory on operating models, platforms, and decisions that compound lifetime value.
        </p>

        <div class="actions">
          <a class="btn btn-primary" href="#contact">Schedule a discovery meeting</a>
          <a class="btn btn-secondary" href="#outcomes">Discover how we work</a>
        </div>

        <div class="trust-pills" aria-label="Trust signals">
          <span class="btn btn-ghost" role="note">Your vision, our expertise</span>
          <span class="btn btn-ghost" role="note">Confidential &amp; secure — NDA friendly</span>
          <span class="btn btn-ghost" role="note">Senior operators at work</span>
        </div>

        <p class="micro" style="margin-top: 28px;">
          Trusted by teams across telco, banking, and SaaS.
        </p>

        <div class="logo-grid" id="experience" aria-label="Experience logos">
          {
            logos.map((src, i) => (
              <div class="logo-tile">
                <img src={src} alt={`Client logo ${i + 1}`} loading="lazy" decoding="async" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="method" aria-label="How we work">
      <div class="container">
        <div class="section-head">
          <p class="section-label">How we work</p>
          <h2 class="display">Four moves that turn AI and customer programs into compounding growth.</h2>
        </div>

        {
          methodBlocks.map((b) => (
            <article class="method-block">
              <div class="method-content">
                <p class="eyebrow">{b.eyebrow}</p>
                <h2>{b.heading}</h2>
                <p>{b.prose}</p>
              </div>
              <div class="method-placeholder" aria-hidden="true"></div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="founder-section" id="founder" aria-label="Founder">
      <div class="container">
        <div class="section-head">
          <p class="section-label">The founder</p>
        </div>

        <div class="founder-grid">
          <figure class="founder-photo">
            <div class="tonal-placeholder square" aria-hidden="true"></div>
            <figcaption>Founder</figcaption>
          </figure>

          <div class="founder-bio">
            <p>
              Two paragraphs introducing the founder — prior operator roles in regulated industries (telco, banking, insurance, SaaS), the specific shape of work delivered there, and the through-line that informs how Capita runs engagements today.
            </p>
            <p>
              A second paragraph naming the founder's view on what's actually shifting in AI-powered customer programs right now, and the kind of leadership team Capita helps best. Founder authors the final copy before ship.
            </p>

            <p class="founder-signed">
              We measure what matters.
              <span class="founder-signed-name">— Founder Name</span>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
