---
import Layout from "../layouts/Layout.astro";

// Founder section is live. Specific quantitative claims (Optus %, JPMC
// $, founding year) are held back per qa/truth-gates-2026-05-21.md
// (claims C3 / C4 / C10) until each is verifiable against a citable
// source.
const SHOW_FOUNDER = true;

// Cal.com discovery-call booking — opt-in via env var. When unset, the
// contact section renders only the form. When set to a Cal.com booking
// URL (e.g. "https://cal.com/mitch/capita-discovery"), the contact
// aside renders a popup-trigger button that opens the Cal.com booking
// flow on click. Popup is preferred over inline iframe so LCP is not
// affected by the embed loader paint. See docs/operational/cal-com-setup.md.
const CAL_BOOKING_URL = import.meta.env.PUBLIC_CAL_BOOKING_URL ?? "";
// Derive the namespace path the Cal.com embed expects (e.g.
// "mitch/capita-discovery") from the full URL. If the env var is set
// but doesn't look like a Cal.com URL, fall back to empty so the
// button is not rendered.
const CAL_BOOKING_NAMESPACE = (() => {
  if (!CAL_BOOKING_URL) return "";
  try {
    const u = new URL(CAL_BOOKING_URL);
    return u.pathname.replace(/^\/+|\/+$/g, "");
  } catch {
    return "";
  }
})();

// Single kinetic phrase per the Ogilvy direction — repetition reads as
// art-direction theatre, not positioning. Rendered once between Method
// and Packages so the page has one rhythmic interruption without
// labouring it.
const KINETIC_PHRASE = "Operators, not consultants.";

// Method blocks — methodology principles that apply across every
// engagement. Distinct from Packages, which describe specific scoped
// engagements with prices. Method is the operating model. Packages
// are the products.
const methodBlocks = [
  {
    number: "01",
    eyebrow: "Principal-led",
    heading: "The senior name on your statement of work delivers it.",
    prose:
      "The principal who scopes your engagement is the one writing the document, attending the workshop, and signing the deliverable. No analyst layer. No project office tax. If you call, that is who picks up.",
  },
  {
    number: "02",
    eyebrow: "Workshop-based",
    heading: "We sit at the table with the executives who own the decision.",
    prose:
      "We come prepared, run a working session, and leave with decisions named. We do not shadow your team for six weeks before forming a view. The result is faster, sharper, and respectful of your time.",
  },
  {
    number: "03",
    eyebrow: "Written deliverables",
    heading: "Every engagement closes with a written document, signed.",
    prose:
      "Decision rights, named owners, and sequenced actions in a written document. Your engineering, product, and operations leads can read it, sign off on it, and execute against it. Yours to redistribute internally.",
  },
  {
    number: "04",
    eyebrow: "Independent",
    heading: "We optimise for one thing: your result.",
    prose:
      "We have no software, no implementation partner taking a cut, and no managed service waiting on the back end. Independence is the entire business model. It is what makes the advice worth its price.",
  },
];

// Packages — outcome-named, "from $X" pricing, highest first per Ogilvy
// anchoring. Slugs flow through to the contact form's package selector.
// Pricing is operationally committed (truth-gate C11); durations match
// the Method block durations one-for-one.
const packages = [
  {
    slug: "om-and-a",
    name: "Operating Model and Architecture",
    eyebrow: "From $85,000",
    duration: "8 to 12 weeks",
    promise:
      "The advisory engagement boards hire us for most: who owns what, decided in writing.",
    inclusions: [
      "Two executive workshops with your CEO, CFO, COO, and CTO.",
      "One architecture review with your engineering and data leads.",
      "A written operating-model document covering decision rights, ownership boundaries, and the target-state architecture.",
      "A 30-day implementation check-in, included.",
    ],
    cta: "Begin scoping a build",
  },
  {
    slug: "diagnosis",
    name: "90-Day Diagnosis",
    eyebrow: "From $45,000",
    duration: "6 to 8 weeks",
    promise:
      "A written diagnosis of why your numbers are not moving. Retention, pricing, or AI delivery.",
    inclusions: [
      "Current-state assessment of where customers are leaving, where pricing is leaking, where journeys break down, or where AI delivery is falling short.",
      "Named owners and the 3 to 5 decisions that, made next quarter, will matter most.",
      "One executive read-out and one written current-state document.",
      "A scoped 90-day plan if you want to take the work further.",
    ],
    cta: "Book the diagnosis",
  },
  {
    slug: "roadmap",
    name: "Roadmap",
    eyebrow: "From $35,000",
    duration: "4 weeks",
    promise:
      "A sequenced 90-day plan your team builds from instead of re-opening every fortnight.",
    inclusions: [
      "Sequenced workstreams, named owners, executive-ready milestones, dependency map.",
      "One steering-committee read-out.",
      "A written roadmap document signed by the engagement lead.",
    ],
    cta: "Scope a roadmap",
  },
  {
    slug: "measurement",
    name: "Measurement and Governance",
    eyebrow: "From $35,000",
    duration: "4 weeks",
    promise:
      "The framework your risk function signs, the cadence your board reviews, written in four weeks.",
    inclusions: [
      "Leading indicators defined for the outcome you're moving.",
      "Quarterly review cadence drafted and trialled with your team.",
      "AI evaluation framework written to satisfy your audit and risk functions.",
      "One handover workshop with your accountable executive.",
    ],
    cta: "Scope the framework",
  },
];

// Outcomes — three columns, proof-driven framing per Ogilvy direction.
// Specific number ranges (e.g., 180–320 bps) are held back per
// qa/truth-gates-2026-05-21.md (C2) until verifiable.
const outcomes = [
  {
    number: "I",
    label: "AI",
    heading: "AI strategy and delivery.",
    prose:
      "We review the gap between your AI roadmap and what is actually shipping. The deliverable is the evaluation framework your risk function signs, the governance cadence your board reviews, and the named owners that hold your delivery leads accountable. We do not build models. We make the ones you build, or buy, answer for themselves.",
  },
  {
    number: "II",
    label: "Retention",
    heading: "Customer retention and growth.",
    prose:
      "We diagnose why customers leave, size the revenue at risk, and write the intervention plan. Every engagement names the operator who owns the work and the metric your finance team will verify. Where renewal, eligibility, or service-recovery friction is leaking revenue, we size the leak and write the 90-day plan to recover the top three.",
  },
  {
    number: "III",
    label: "Productivity",
    heading: "Productivity acceleration.",
    prose:
      "We find where your operating model is leaking time. Duplicate decisions, ambiguous ownership, meetings that produce nothing. The deliverable is a sequenced 90-day plan to reclaim the capacity your business already has, with named owners, milestones your executives will recognise, and the dependency map your steering committee can govern.",
  },
];

// FAQ — procurement-grade buyer-objection handlers per Ogilvy direction.
// Six entries: five existing rewrites + a price-question (Q6) that
// references the packages on this page.
const faqs = [
  {
    id: 1,
    q: "What do I receive in writing at the end of the engagement, and who signs it?",
    a: "A written deliverable, signed by the engagement lead: diagnosis, operating model, roadmap, or measurement framework, depending on the package. For bespoke work, the engagement principal signs. Every deliverable is yours to redistribute internally. We do not retain confidential client work in case studies without written permission.",
  },
  {
    id: 2,
    q: "Do you implement, build, or resell?",
    a: "No. Capita is advisory only. We do not sell implementation hours, we do not partner with systems integrators for kickbacks, and we will name the implementation partners we believe are credible for your problem if you ask. Our independence is the product.",
  },
  {
    id: 3,
    q: "Will you sign an NDA, and do you work inside regulated environments?",
    a: "Yes to both. We have signed mutual NDAs for every named engagement and have operated inside APRA-, ASIC-, and ACMA-regulated programmes. Privacy-by-design and data-handling protocols are written into every statement of work.",
  },
  {
    id: 4,
    q: "Who does the work: the principal, or a junior team?",
    a: "The principal named on your statement of work leads every engagement and writes the final deliverable. We are deliberately a small firm. There is no analyst layer to bill against your retainer.",
  },
  {
    id: 5,
    q: "How do we know the work has changed the business after you leave?",
    a: "Every engagement includes the leading indicators we expect to move, the review cadence we expect your team to run, and a written 90-day check-in, included in price. If the indicators have not moved at the 90-day mark, we re-scope a no-fee follow-up week to find out why.",
  },
  {
    id: 6,
    q: "Why do you publish prices when most advisory firms do not?",
    a: "Because executives spending their company's money should be able to estimate the cost of a conversation with us before they have it. The four packages on this page cover the work we are most often asked to scope: Operating Model and Architecture, 90-Day Diagnosis, Roadmap, and Measurement and Governance. Bespoke engagements are quoted on request and start at $120,000.",
  },
];
---

<Layout>
  <main id="main">
    <section class="hero" aria-label="Hero">
      <div class="container">
        <p class="eyebrow">Independent. Run by ex-operators. Advisory only.</p>
        <h1 class="display">We help with AI, customer retention, and productivity.</h1>
        <p class="lede">
          We've done the job. Every engagement ends with a written plan signed by the principal. Packages from $35,000. Bespoke on request.
        </p>

        <div class="actions">
          <a class="btn btn-primary" href="#packages">See the four packages and prices.</a>
          <a class="btn btn-secondary" href="#bespoke">Talk to us about a bespoke engagement.</a>
        </div>
      </div>
    </section>

    {/* Sentinel for the body.grid-calm toggle. When this scrolls above the
        viewport top, body sections render over the calmed grid tint; when
        it's still visible (user is at/near hero), grid renders at full
        intensity. Observed by the inline script in Layout.astro. */}
    <div id="grid-calm-sentinel" aria-hidden="true" style="height: 1px;"></div>

    <div class="kinetic-phrase" aria-hidden="true">
      <div class="kinetic-phrase-track">
        <span>{KINETIC_PHRASE}</span>
      </div>
    </div>

    <section class="section section-plate" id="method" aria-label="How we work">
      <div class="container">
        <div class="section-head">
          <p class="section-label">How we work</p>
          <h2 class="display">Four principles built into every engagement.</h2>
        </div>

        {
          methodBlocks.map((b) => (
            <article class="method-block">
              <div class="method-anchor" aria-hidden="true">{b.number}</div>
              <div class="method-content">
                <p class="eyebrow">{b.eyebrow}</p>
                <h3>{b.heading}</h3>
                <p>{b.prose}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section-plate" id="packages" aria-label="Packages and prices">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Packages</p>
          <h2 class="display">Four packages, with prices. Highest first.</h2>
          <p class="lede">
            Each package below is dated, scoped, and priced. "From $X" is an honest range. Engagements run longer or wider when the scope warrants it. The four cover the engagements we are most often asked to scope. Bespoke continues beneath them.
          </p>
        </div>

        <div class="package-stack">
          {
            packages.map((p) => (
              <article class="package-card" id={`package-${p.slug}`}>
                <p class="package-eyebrow">{p.eyebrow}</p>
                <h3 class="package-name">{p.name}</h3>
                <p class="package-duration">{p.duration}</p>
                <p class="package-promise"><em>{p.promise}</em></p>
                <ul class="package-inclusions">
                  {p.inclusions.map((line) => (<li>{line}</li>))}
                </ul>
                <div class="package-cta">
                  <a class="btn btn-primary" href="#contact" data-package={p.slug}>{p.cta}</a>
                </div>
              </article>
            ))
          }
        </div>

        <div class="bespoke-band" id="bespoke">
          <p class="eyebrow">Bespoke advisory</p>
          <p class="bespoke-body">
            For boards running programmes the four packages above do not cover: multi-business-unit operating-model redesigns, board-led transformations, regulated-entity governance builds. The engagement principal sits on your steering committee for the duration. <strong>From $120,000, scoped within five business days.</strong>
          </p>
          <div class="package-cta">
            <a class="btn btn-secondary" href="#contact" data-package="bespoke">Talk to us about a bespoke engagement.</a>
          </div>
        </div>
      </div>
    </section>

    {/* 90-day commitment — risk-reversal band, immediately after Packages
        per Ogilvy direction. Visually quiet (small-caps eyebrow,
        constrained width) but unmistakable. Applies to every package and
        every bespoke engagement; the commitment is written into the SOW. */}
    <section class="commitment-band section-plate" id="commitment" aria-label="Our 90-day commitment">
      <div class="container">
        <p class="eyebrow">Our 90-day commitment</p>
        <p class="commitment-body">
          If, at the 90-day mark after your engagement closes, the leading indicators we defined together have not moved, we return for a no-fee follow-up week to find out why. This is written into every statement of work. It applies to every package on this page and to bespoke engagements.
        </p>
      </div>
    </section>

    {SHOW_FOUNDER && (
      <section class="founder-section section-plate" id="founder" aria-label="From the founder">
        <div class="container">
          <div class="section-head">
            <p class="section-label">From the founder</p>
            <h2 class="display">Why we publish prices, and why we are advisory only.</h2>
          </div>

          <div class="founder-grid">
            <figure class="founder-photo">
              <div class="tonal-placeholder" aria-hidden="true"></div>
              <figcaption>Mitchell Ribar, Principal</figcaption>
            </figure>

            <div class="founder-bio">
              <p>
                Until now, Capita Technology has operated only on bespoke retainers. Every engagement was scoped to the client and priced in a back-and-forth that took 2 to 6 weeks before the work could begin.
              </p>
              <p>
                We are changing that for one reason. Boards and executive teams have told us, repeatedly, that the cost of figuring out what an advisory engagement costs is itself a tax on getting the work done. 3 meetings, 4 follow-ups, an internal procurement cycle, all before the work can begin. If you are a Chief Customer Officer with a quarterly board commitment to move retention by 200 basis points, the last thing you need is a 6-week procurement process to hire the advisory firm that will help you do it.
              </p>
              <p>
                So we are publishing the four engagements we are most often asked to scope, with their inclusions, durations, and prices, on this page. The rest are bespoke. Usually a board-led programme, a multi-business-unit operating-model redesign, or an AI governance build for a regulated entity. We continue to scope those on a retainer basis. Bespoke engagements start at $120,000 and are quoted within 5 business days.
              </p>
              <p>
                We are advisory only. We do not build, implement, resell, or partner with systems integrators for revenue share. Our independence is the product.
              </p>

              <p class="founder-signed">
                I am Mitchell Ribar. I started Capita Technology because I was tired of hiring consultancies that produced beautiful decks and nothing that shipped. Every engagement on this site is led by an operator who has run the role they are now advising. I have led retention recovery at Optus, the multi-year AI Personalization programme at JPMorgan Chase, P&amp;L ownership at Brand Networks, and financial-services product leadership at Quantium. If you are about to spend $50,000 to $500,000 on advisory, I think you should know who is on the other end of the email.
                <span class="founder-signed-name">Mitchell Ribar, Principal.</span>
              </p>

              {/* Cross-brand forward link (U32) — quiet, single line. */}
              <p class="founder-crosslink">
                Mitch also runs <a href="https://ribar.ai" rel="noopener">Ribar.ai</a>, a 12-week 1:1 AI executive program for senior leaders.
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="section section-plate" id="outcomes" aria-label="Outcomes">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Outcomes</p>
          <h2 class="display">Three outcomes we are hired to move.</h2>
          <p class="lede">The three our advisory work is most often hired to move.</p>
        </div>

        <div class="outcome-grid">
          {
            outcomes.map((o) => (
              <article class="outcome-col">
                <p class="eyebrow">{o.number} · {o.label}</p>
                <h3>{o.heading}</h3>
                <p>{o.prose}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-plate" id="faq" aria-label="Frequently asked questions">
      <div class="container">
        <div class="section-head">
          <p class="section-label">FAQ</p>
          <h2 class="display">What boards ask us before they sign.</h2>
        </div>

        <div class="faq-stack">
          {
            faqs.map((f) => (
              <article class="faq-card">
                <button
                  class="faq-q"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`faq-a${f.id}`}
                  id={`faq-q${f.id}`}
                >
                  {f.q}
                </button>
                <div class="faq-a" id={`faq-a${f.id}`} role="region" aria-labelledby={`faq-q${f.id}`} hidden>
                  <p>{f.a}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-plate" id="contact" aria-label="Contact">
      <div class="container">
        <div class="section-head">
          <p class="section-label">Talk to us</p>
          <h2 class="display">Tell us what you need to change in the next 90 days. We reply within 2 business days with a scoped proposal and a price.</h2>
        </div>

        <div class="contact-grid">
          <form
            id="leadForm"
            action="https://formspree.io/f/xojdzarv"
            method="post"
            novalidate
          >
            {/* Honeypot — renamed to `website` so the real Company field below
                can claim `company`. Hidden offscreen; populated honeypot
                aborts submission. */}
            <div style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
              <label>
                Website
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="field-row">
              <label class="field-label">
                <span class="micro">Name (required)</span>
                <input
                  id="name"
                  name="name"
                  class="field-input"
                  required
                  autocomplete="name"
                  inputmode="text"
                  maxlength="60"
                  placeholder="Jane Smith"
                  aria-describedby="error-name"
                />
                <p id="error-name" class="field-error" role="alert" hidden></p>
              </label>

              <label class="field-label">
                <span class="micro">Work email (required)</span>
                <input
                  id="email"
                  name="email"
                  type="email"
                  class="field-input"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="jane@company.com"
                  aria-describedby="error-email"
                />
                <p id="error-email" class="field-error" role="alert" hidden></p>
              </label>
            </div>

            <div class="field-row">
              <label class="field-label">
                <span class="micro">Company (required)</span>
                <input
                  id="company"
                  name="company"
                  class="field-input"
                  required
                  autocomplete="organization"
                  inputmode="text"
                  maxlength="120"
                  placeholder="Acme Telco"
                  aria-describedby="error-company"
                />
                <p id="error-company" class="field-error" role="alert" hidden></p>
              </label>

              <label class="field-label">
                <span class="micro">Role (required)</span>
                <input
                  id="role"
                  name="role"
                  class="field-input"
                  required
                  autocomplete="organization-title"
                  inputmode="text"
                  maxlength="120"
                  placeholder="Chief Customer Officer"
                  aria-describedby="error-role"
                />
                <p id="error-role" class="field-error" role="alert" hidden></p>
              </label>
            </div>

            <div class="field-row">
              <div>
                <span class="micro">Country code</span>
                <div class="cc-wrap" style="margin-top: 8px;">
                  <input
                    id="ccSearch"
                    name="ccSearch"
                    class="field-input"
                    role="combobox"
                    aria-expanded="false"
                    aria-controls="ccList"
                    aria-autocomplete="list"
                    autocomplete="off"
                    inputmode="search"
                    placeholder="Australia (+61)"
                  />
                  <div id="ccList" class="cc-list" role="listbox" aria-label="Country codes">
                    <div id="ccOptions" class="cc-options"></div>
                  </div>
                  <input type="hidden" id="ccDial" name="ccDial" value="+61" />
                  <input type="hidden" id="ccISO3" name="ccISO3" value="AUS" />
                  <input type="hidden" id="ccISO2" name="ccISO2" value="AU" />
                </div>
              </div>

              <label class="field-label">
                <span class="micro">Phone (optional)</span>
                <input
                  id="phone"
                  name="phone"
                  class="field-input"
                  autocomplete="tel-national"
                  inputmode="tel"
                  maxlength="24"
                  placeholder="412 345 678"
                  pattern={"^[0-9()\\-\\s]{0,24}$"}
                  aria-describedby="error-phone"
                />
                <p id="error-phone" class="field-error" role="alert" hidden></p>
              </label>
            </div>

            <div class="field-row single">
              <label class="field-label">
                <span class="micro">Which package, or describe the bespoke problem you need solved</span>
                <select id="package" name="package" class="field-input" aria-describedby="error-package">
                  <option value="not-sure">Not sure yet. Let's discuss.</option>
                  <option value="om-and-a">Operating Model and Architecture (from $85k)</option>
                  <option value="diagnosis">90-Day Diagnosis (from $45k)</option>
                  <option value="roadmap">Roadmap (from $35k)</option>
                  <option value="measurement">Measurement and Governance (from $35k)</option>
                  <option value="bespoke">Bespoke. Tell us more below.</option>
                </select>
              </label>
            </div>

            <div class="field-row single">
              <label class="field-label">
                <span class="micro">What you need to change, and by when</span>
                <textarea
                  id="message"
                  name="message"
                  class="field-textarea"
                  rows="5"
                  maxlength="2000"
                  placeholder="e.g. Bring annualised churn down 200 bps by the end of FY27."></textarea>
              </label>
            </div>

            <div id="formError" class="micro" style="margin-top: 14px;"></div>
            <div id="formSuccess" class="lede" style="margin-top: 14px;" role="status" aria-live="polite"></div>

            <div class="actions" style="margin-top: 24px;">
              <button class="btn btn-primary" type="submit">Send this to Capita</button>
            </div>
          </form>

          <aside class="contact-pains" aria-label="What we understand">
            <h3>If any of these are on your executive's worry list, we should talk.</h3>
            <p>These are 5 of the problems boards have hired us to fix:</p>
            <ul>
              <li>No one owns retention end-to-end, so no one is accountable when it slips.</li>
              <li>If your CFO cannot measure your strategy, you have a slide deck.</li>
              <li>Decisions take 6 weeks because no one knows who is allowed to make them.</li>
              <li>You suspect customers drop off at renewal, but no one can size it.</li>
              <li>The roadmap your team signed off in January no longer matches what is shipping in March.</li>
            </ul>

            {CAL_BOOKING_NAMESPACE && (
              <div class="contact-cal" aria-label="Or book a discovery call">
                <p class="micro">Or skip the form and put a 30-minute discovery call on the calendar:</p>
                <button
                  type="button"
                  class="btn btn-secondary"
                  data-cal-link={CAL_BOOKING_NAMESPACE}
                  data-cal-namespace=""
                  data-cal-config='{"layout":"month_view"}'
                >
                  Book a discovery call
                </button>
              </div>
            )}
          </aside>
        </div>
      </div>
    </section>
  </main>

  {CAL_BOOKING_NAMESPACE && (
    <script is:inline define:vars={{ namespace: CAL_BOOKING_NAMESPACE }}>
      // Cal.com inline loader — minimal version of the official snippet,
      // wired only when an env-var booking link is present. The loader
      // appends the embed.js script to <head> on first use; subsequent
      // Cal() calls reuse it. `data-cal-link` buttons in the document
      // (see #contact .contact-cal) are auto-wired by embed.js once it
      // resolves. Loader is intentionally below-the-fold so it does not
      // contend with the LCP paint.
      (function (C, A, L) {
        const p = function (a, ar) { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const ns = ar[1];
            api.q = api.q || [];
            if (typeof ns === "string") {
              cal.ns[ns] = cal.ns[ns] || api;
