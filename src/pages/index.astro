---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main style="padding: var(--pad-y) var(--pad-x); max-width: var(--container); margin-inline: auto;">
    <h1 style="font-size: var(--type-h1); letter-spacing: -0.04em; line-height: 1.02; margin: 0;">
      Capita Technology
    </h1>
    <p style="font-size: var(--type-lede); color: var(--muted); max-width: 62ch; margin-top: 16px;">
      Independent executive advisory on operating models, platforms, and decisions that compound lifetime value.
    </p>
    <p style="font-size: var(--type-micro); color: var(--muted); margin-top: 32px;">
      U1 placeholder — full editorial layout lands in U3–U10.
    </p>
  </main>
</Layout>
