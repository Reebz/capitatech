            return;
          }
          if (e.key === "ArrowUp") {
            e.preventDefault();
            openList();
            const opts = visibleOptions();
            focusOption(opts.length - 1);
            return;
          }
          if (e.key === "Home") {
            e.preventDefault();
            focusOption(0);
            return;
          }
