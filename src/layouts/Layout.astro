---
import "@fontsource-variable/inter/wght.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Capita Technology",
  description = "Capita Technology helps leadership teams unlock measurable retention and lifetime value by designing AI-powered decision systems, operating models, and customer experience measurement.",
} = Astro.props;
---

<!doctype html>
<html lang="en" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>

    <script is:inline>
      // HTTPS redirect (runs before paint). Defense in depth — Vercel's edge
      // also redirects HTTP → HTTPS, but this guards against direct origin
      // access during testing or any future edge misconfiguration.
      (function () {
        const isLocal =
          location.hostname === "localhost" ||
          location.hostname === "127.0.0.1" ||
          location.hostname.endsWith(".local");
        if (!isLocal && location.protocol !== "https:") {
          location.replace(
            "https://" + location.host + location.pathname + location.search + location.hash
          );
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="top">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="Capita Technology">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">Capita Technology</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a href="#outcomes">Outcomes</a>
          <a href="#faq">FAQ</a>
          <a href="#contact">Contact</a>
          <a class="nav-cta" href="#contact">Request intro</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer" aria-label="Footer">
      <div class="container">
        <div class="footer-inner">
          <p>© <span id="y"></span> Capita Technology. Sydney, Australia.</p>
          <div class="footer-links">
            <a href="#top">Top</a>
            <a href="#outcomes">Outcomes</a>
            <a href="#faq">FAQ</a>
            <a href="#contact">Contact</a>
          </div>
        </div>

        <div class="footer-tiles">
          <div class="tile">
            <h3>Contact</h3>
            <p class="micro">consulting@capitatech.com.au</p>
            <p class="micro">Sydney, NSW · Australia</p>
          </div>
          <div class="tile">
            <h3>Services</h3>
            <p class="micro">Strategy · Maturity assessments · Architecture review · Roadmaps</p>
            <p class="micro">Executive workshops · Requirements definition · Decision frameworks</p>
          </div>
          <div class="tile">
            <h3>Industries</h3>
            <p class="micro">Telecommunications · Banking · Insurance · Property · SaaS · Subscription businesses</p>
            <p class="micro">Regulated delivery · Governance · Security · Privacy-by-design</p>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Year-stamp runs after parse so #y exists in the DOM.
      document.getElementById("y").textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
