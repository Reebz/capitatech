          // wrapper padding / label don't immediately re-close the list.
          const inside = wrap && wrap.contains(e.target);
          if (!inside) closeList();
        });

        // Expose a reset hook so the form-handler can restore the AU
        // default display after form.reset() wipes the search input.
        window.__capitaResetCountryPicker = function () {
          ccDial.value = defaultAU.dial;
          ccISO2.value = defaultAU.iso2;
          ccISO3.value = defaultAU.iso3;
          search.value = defaultDisplay;
          render(COUNTRY_CODES);
        };

        // Expose a restore hook so the draft-persistence layer can re-apply a
        // saved country selection (display + hidden fields) on page load.
        // Unknown ISO2 falls back to the AU default. Returns true when a
        // non-default country was restored so the caller can tell a real
        // saved value from a no-op.
        window.__capitaSetCountryPickerByISO2 = function (iso2) {
          const match = COUNTRY_CODES.find((c) => c.iso2 === String(iso2 || "").toUpperCase());
          const c = match || defaultAU;
          ccDial.value = c.dial;
          ccISO2.value = c.iso2;
          ccISO3.value = c.iso3;
          search.value = formatItem(c);
          render(COUNTRY_CODES);
          return Boolean(match);
        };
      })();

      // 5. Form validate + Formspree POST.
      (function initLeadForm() {
        const FORMSPREE_ENDPOINT = "https://formspree.io/f/xojdzarv";
        const form = document.getElementById("leadForm");
