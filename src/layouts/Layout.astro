        // error lifecycle decision: errors persist until the user starts
        // correcting, not on every keystroke and not only at re-submit).
        for (const id of ["name", "email", "company", "role", "phone"]) {
          const el = document.getElementById(id);
          if (el) el.addEventListener("input", function () { clearFieldError(id); });
        }

        // Single source of truth for per-field validity — the exact same
        // predicates and copy the submit pass uses, so blur-time and
        // submit-time validation can never drift. Returns true when valid.
        // An empty field is treated as not-yet-validated on blur (no error
        // shown for a field the user merely tabbed through) — the submit
        // pass still enforces presence via checkValidity(required).
        function validateField(id) {
          const el = document.getElementById(id);
          if (!el) return true;
          if (id === "phone") {
            const phone = normalizeSpaces(el.value);
            if (!isValidPhoneLocal(phone)) {
              setFieldError(
                "phone",
                "Phone must contain digits only (spaces/dashes allowed) and be 4–14 digits.",
              );
              return false;
            }
            clearFieldError("phone");
            return true;
          }
          // Don't nag on an empty optional-looking field at blur; let submit
          // handle required-but-empty so tabbing through stays quiet.
          if (!String(el.value || "").trim()) {
            clearFieldError(id);
            return true;
          }
          if (id === "name") {
            const name = normalizeSpaces(el.value);
            if (!el.checkValidity() || !isValidName(name)) {
              setFieldError(
                "name",
                "Name must be 2–60 characters of letters (and spaces, apostrophes, or hyphens).",
              );
              return false;
            }
          } else if (id === "email") {
            if (!el.checkValidity() || !isValidEmail(el)) {
              setFieldError("email", "Enter a valid email address.");
              return false;
            }
          } else if (id === "company") {
            const company = normalizeSpaces(el.value);
            if (!el.checkValidity() || !isValidFreeText(company, 2, 120)) {
              setFieldError("company", "Company must be 2–120 characters.");
              return false;
            }
          } else if (id === "role") {
            const role = normalizeSpaces(el.value);
            if (!el.checkValidity() || !isValidFreeText(role, 2, 120)) {
              setFieldError("role", "Role must be 2–120 characters.");
              return false;
            }
          }
          clearFieldError(id);
          return true;
        }
        // On-blur validation: each field validates when the user leaves it,
        // so problems surface field-by-field instead of only at submit. The
        // submit-time all-at-once pass remains the backstop. Blur only reads
        // and reports — it never preventDefaults or blocks submit.
        for (const id of ["name", "email", "company", "role", "phone"]) {
          const el = document.getElementById(id);
          if (el) el.addEventListener("blur", function () { validateField(id); });
        }
        function setSuccess(m) {
          // textContent + DOM-built <strong> instead of innerHTML so any
          // future contributor extending this with a non-static message
          // can't accidentally introduce XSS.
          if (!ok) return;
          ok.innerHTML = "";
          if (m) {
            const strong = document.createElement("strong");
            strong.textContent = m;
            ok.appendChild(strong);
          }
          if (err) err.textContent = "";
        }
        function setPending(value) {
          pending = value;
          if (submitBtn) {
            submitBtn.disabled = value;
            submitBtn.textContent = value ? "Sending…" : "Send this to Capita";
          }
        }

        // ── Draft persistence ────────────────────────────────────────────
        // Saves the visible fields to localStorage so a prospect who gets
        // interrupted mid-form doesn't lose their typing. Versioned key lets
        // a future schema change invalidate old drafts cleanly. The honeypot
        // (`website`) is never persisted. Writes are debounced and only fire
        // once the user has actually typed something, so an untouched form
        // never creates a draft. Per-field length caps mirror the input
        // maxlengths so a tampered localStorage value can't overflow a field.
        const DRAFT_KEY = "capita-lead-draft-v1";
        const DRAFT_CAPS = { name: 60, email: 254, company: 120, role: 120, ccSearch: 80, phone: 24, message: 2000 };
        // `search` lives in the country-picker closure; resolve it here by id
        // so this closure can read/restore the country field too. Declared up
        // top so the autosave wiring below can reference it without hitting
        // the temporal dead zone.
        const search = document.getElementById("ccSearch");
        function lsAvailable() {
          try {
            const k = "__capita_probe__";
            window.localStorage.setItem(k, "1");
            window.localStorage.removeItem(k);
            return true;
          } catch (_) {
            return false;
          }
        }
        const STORAGE_OK = lsAvailable();
        function clearDraft() {
