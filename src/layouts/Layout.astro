          try {
            window.localStorage.removeItem(DRAFT_KEY);
          } catch (_) {
            /* storage gone mid-session — nothing to clear. */
          }
        }
        function capValue(key, value) {
          const cap = DRAFT_CAPS[key];
          const s = String(value == null ? "" : value);
          return cap ? s.slice(0, cap) : s;
        }
        function readForm() {
          // ccISO2 is captured alongside the display so the picker can be
          // restored to the exact saved country, not just its text.
          const ccISO2El = document.getElementById("ccISO2");
          return {
            name: nameEl ? nameEl.value : "",
            email: emailEl ? emailEl.value : "",
            company: companyEl ? companyEl.value : "",
            role: roleEl ? roleEl.value : "",
            ccSearch: search ? search.value : "",
            ccISO2: ccISO2El ? ccISO2El.value : "",
            phone: phoneEl ? phoneEl.value : "",
            package: packageEl ? packageEl.value : "",
            message: msgEl ? msgEl.value : "",
          };
        }
        function hasAnyContent(d) {
          // Only persist once the user has typed a field that isn't a default.
          // The country picker text defaults to the AU display, so it alone
          // doesn't count as "typed".
          return Boolean(
            (d.name && d.name.trim()) ||
            (d.email && d.email.trim()) ||
            (d.company && d.company.trim()) ||
            (d.role && d.role.trim()) ||
            (d.phone && d.phone.trim()) ||
            (d.message && d.message.trim()) ||
