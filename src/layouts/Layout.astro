        // hidden dial/ISO must not keep a stale previously-selected value —
        // a visually-empty country would otherwise submit the old dial code.
        // Snap the hidden fields back to the AU default the moment the text
        // goes empty (display is left blank here so the user can keep typing;
        // the AU display is restored on blur if they leave it empty).
        search.addEventListener("input", () => {
          if (!String(search.value || "").trim()) {
