---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/geist/wght.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Capita Technology",
  description = "Capita Technology helps leadership teams unlock measurable retention and lifetime value by designing AI-powered decision systems, operating models, and customer experience measurement.",
} = Astro.props;

// Server-rendered ASCII grid. Generous size to cover ultrawide displays at the
// smallest font-size in the clamp; CSS clips bleed via overflow:hidden on the
// fixed layer. Character mix is deterministic (seeded from row/col) so the
// texture is identical across builds — sparse +, ∙, * break the dot monotony
// without visually competing with foreground content.
const ASCII_COLS = 320;
const ASCII_ROWS = 80;
const gridChar = (r: number, c: number): string => {
  const h = ((r * 73856093) ^ (c * 19349663) ^ (r * c * 83492791)) >>> 0;
  const v = h % 100;
  if (v < 4) return " ";
  if (v < 12) return "*";
  if (v < 17) return "+";
  if (v < 22) return "∙";
  return "·";
};
const ascii = Array.from({ length: ASCII_ROWS }, (_, r) =>
  Array.from({ length: ASCII_COLS }, (_, c) => gridChar(r, c)).join(""),
).join("\n");
---

<!doctype html>
<html lang="en" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0078f0" />

    {/* Open Graph + Twitter Card meta. og:image and twitter:image are
        absolute URLs because the OG protocol requires it. The same static
        1200×630 PNG serves both LinkedIn (large card) and X
        (summary_large_image). */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Capita Technology" />
    <meta property="og:url" content="https://capitatech.com.au/" />
    <meta property="og:image" content="https://capitatech.com.au/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://capitatech.com.au/og-image.png" />

    {/* Favicon set + manifest. SVG is the primary icon (sharp at every
        size); raster fallbacks cover legacy browsers and iOS home-screen. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <title>{title}</title>

    <script is:inline>
      // HTTPS redirect (runs before paint). Defense in depth — Vercel's edge
      // also redirects HTTP → HTTPS. The bypass list covers localhost,
      // 127.0.0.1, *.local (portless TLD), AND *.localhost so dev URLs in
      // any common shape are unaffected.
      (function () {
        const h = location.hostname;
        const isLocal =
          h === "localhost" ||
          h === "127.0.0.1" ||
          h.endsWith(".local") ||
          h.endsWith(".localhost");
        if (!isLocal && location.protocol !== "https:") {
          location.replace(
            "https://" + location.host + location.pathname + location.search + location.hash
          );
        }
      })();
    </script>
  </head>

  <body>
    <pre id="ascii-grid" class="ascii-grid" aria-hidden="true">{ascii}</pre>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header layer-fg" id="top">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="Capita Technology">
          <span class="brand-text">Capita<span style="color: var(--accent)">.</span>Technology</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a href="#method">Method</a>
          <a href="#outcomes">Outcomes</a>
          <a href="#faq">FAQ</a>
          <a class="nav-cta" href="#contact">Request intro</a>
        </nav>
      </div>
    </header>

    <div class="layer-fg"><slot /></div>

    <footer class="site-footer layer-fg" aria-label="Footer">
      <div class="container">
        <div class="footer-inner">
          <p>© <span id="y"></span> Capita Technology. Sydney, Australia.</p>
          <div class="footer-links">
            <a href="#top">Top</a>
            <a href="#method">Method</a>
            <a href="#outcomes">Outcomes</a>
            <a href="#faq">FAQ</a>
            <a href="#contact">Contact</a>
          </div>
        </div>

        <div class="footer-tiles">
          <div class="tile">
            <h3>Contact</h3>
            <p class="micro">consulting@capitatech.com.au</p>
            <p class="micro">Sydney, NSW · Australia</p>
          </div>
          <div class="tile">
            <h3>Services</h3>
            <p class="micro">Strategy · Maturity assessments · Architecture review · Roadmaps</p>
            <p class="micro">Executive workshops · Requirements definition · Decision frameworks</p>
          </div>
          <div class="tile">
            <h3>Industries</h3>
            <p class="micro">Telecommunications · Banking · Insurance · Property · SaaS · Subscription businesses</p>
            <p class="micro">Regulated delivery · Governance · Security · Privacy-by-design</p>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // ASCII spotlight + idle drift + two-tier grid intensity.
      // Mirrors the Cavaro mechanism with mid-session matchMedia listeners
      // and Page Visibility handling that Cavaro's one-time check lacks.
      (function initSpotlight() {
        const grid = document.getElementById("ascii-grid");
        if (!grid) return;

        const reducedMotionMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
        const cursorMQ = window.matchMedia("(hover: hover) and (pointer: fine)");
        let reducedMotion = reducedMotionMQ.matches;
        let hasCursor = cursorMQ.matches;
        let idleActive = !hasCursor;
        let rafId = 0;
        let idleStart = performance.now();

        function setPos(x, y) {
          grid.style.setProperty("--mx", x + "px");
          grid.style.setProperty("--my", y + "px");
        }

        function clearGradient() {
          // Removes the spotlight position so CSS falls back to the flat
          // dot tint only — used under reduced-motion.
          grid.style.removeProperty("--mx");
          grid.style.removeProperty("--my");
        }

        function idleLoop(now) {
          if (reducedMotion || !idleActive) return;
          // Lissajous orbit, asymmetric X/Y so the path doesn't repeat
          // visibly within a session. X period ~4500ms, Y at 0.7× freq.
          const t = (now - idleStart) / 4500;
          const w = window.innerWidth;
          const h = window.innerHeight;
          const cx = w / 2;
          const cy = h / 2;
          const radius = Math.min(w, h) * 0.42;
          const x = cx + Math.cos(t * 2 * Math.PI) * radius;
          const y = cy + Math.sin(t * 2 * Math.PI * 0.7) * radius * 0.65;
          setPos(x, y);
          rafId = requestAnimationFrame(idleLoop);
        }

        function startIdle() {
          if (reducedMotion) return;
          idleActive = true;
          idleStart = performance.now();
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(idleLoop);
        }

        function stopIdle() {
          idleActive = false;
          cancelAnimationFrame(rafId);
        }

        function applyMotionState() {
          if (reducedMotion) {
            stopIdle();
            clearGradient();
            return;
          }
          if (hasCursor) {
            // Wait for first mousemove; idle drift fills the gap.
            startIdle();
          } else {
            startIdle();
          }
        }

        function onMouseMove(e) {
          if (reducedMotion) return;
          stopIdle();
          // Single rAF coalesces multi-events-per-frame from high-Hz mice.
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(function () {
            setPos(e.clientX, e.clientY);
          });
        }

        function onMouseLeave() {
          if (reducedMotion || !hasCursor) return;
          startIdle();
        }

        function attachCursorListeners() {
          if (!hasCursor) return;
          window.addEventListener("mousemove", onMouseMove, { passive: true });
          document.addEventListener("mouseleave", onMouseLeave);
        }

        function detachCursorListeners() {
          window.removeEventListener("mousemove", onMouseMove);
          document.removeEventListener("mouseleave", onMouseLeave);
        }

        // Initial wiring.
        applyMotionState();
        attachCursorListeners();

        // Mid-session reactivity: OS reduced-motion toggle and cursor
        // capability change (e.g., iPad keyboard connect) update state
        // within one frame without a page reload.
        reducedMotionMQ.addEventListener("change", function (e) {
          reducedMotion = e.matches;
          applyMotionState();
        });
        cursorMQ.addEventListener("change", function (e) {
          const wasCursor = hasCursor;
          hasCursor = e.matches;
          if (wasCursor && !hasCursor) {
            detachCursorListeners();
          } else if (!wasCursor && hasCursor) {
            attachCursorListeners();
          }
          applyMotionState();
        });

        // Page Visibility: reset idle clock when the tab is restored from
        // background so the Lissajous position doesn't skip. rAF is paused
        // by the browser when the tab is hidden; without this, the next
        // frame would compute against a stale `idleStart`.
        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState === "visible" && idleActive && !reducedMotion) {
            idleStart = performance.now();
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(idleLoop);
          }
        });
      })();

      // Kinetic phrase scroll-driven horizontal travel. Each .kinetic-phrase
      // band gets an IntersectionObserver that attaches a scroll handler
      // when the band enters the viewport. The handler computes band-center
      // vs viewport-center as a -1..+1 progress value and writes it to a
      // --kinetic-progress CSS custom property; CSS reads the property to
      // apply translateX. Reduced-motion gates the attach — no scroll
      // listener fires under reduced motion.
      (function initKineticPhrase() {
        const bands = document.querySelectorAll(".kinetic-phrase");
        if (!bands.length) return;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reducedMotion) return;

        const tracked = new Set();
        let scrollRaf = 0;

        function updateBand(band) {
          const rect = band.getBoundingClientRect();
          const viewportCenter = window.innerHeight / 2;
          const bandCenter = rect.top + rect.height / 2;
          // Distance from viewport center, normalized by half-viewport-height
          // so progress is roughly -1..+1 across the natural scroll arc.
          const range = window.innerHeight / 2 + rect.height / 2;
          const progress = (viewportCenter - bandCenter) / range;
          const clamped = Math.max(-1, Math.min(1, progress));
          band.style.setProperty("--kinetic-progress", String(clamped));
        }

        function onScroll() {
          if (scrollRaf) return;
          scrollRaf = requestAnimationFrame(function () {
            scrollRaf = 0;
            for (const band of tracked) updateBand(band);
          });
        }

        const observer = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                tracked.add(entry.target);
                updateBand(entry.target);
              } else {
                tracked.delete(entry.target);
              }
            }
            // Toggle listener based on whether anything is currently visible.
            if (tracked.size > 0) {
              window.addEventListener("scroll", onScroll, { passive: true });
            } else {
              window.removeEventListener("scroll", onScroll);
            }
          },
          { rootMargin: "20% 0px 20% 0px", threshold: 0 },
        );
        for (const band of bands) observer.observe(band);
      })();

      // Two-tier grid intensity: body.grid-calm flips when the user has
      // scrolled past the hero AND the footer is not yet in view. Hero +
      // footer remain at full intensity; body sections (logo grid, method,
      // outcomes, FAQ, contact) read the calmed tint via CSS.
      (function initGridIntensity() {
        const sentinel = document.getElementById("grid-calm-sentinel");
        const footer = document.querySelector(".site-footer");
        if (!sentinel || !footer) return;

        let heroExited = false;
        let footerInView = false;

        function apply() {
          // Calm when past hero AND footer not yet visible.
          if (heroExited && !footerInView) {
            document.body.classList.add("grid-calm");
          } else {
            document.body.classList.remove("grid-calm");
          }
        }

        // Sentinel sits at the end of the hero. When it scrolls above the
        // viewport top, the user has read past the hero.
        const heroObserver = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              // `isIntersecting` flips when the sentinel enters/exits the
              // viewport. We want "above the viewport top" which manifests
              // as boundingClientRect.top < 0 when not intersecting.
              if (entry.isIntersecting) {
                heroExited = false;
              } else if (entry.boundingClientRect.top < 0) {
                heroExited = true;
              }
            }
            apply();
          },
          { rootMargin: "0px", threshold: 0 },
        );
        heroObserver.observe(sentinel);

        // Footer observer: when the footer enters viewport (even partially),
        // return to full intensity so its closing band reads.
        const footerObserver = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              footerInView = entry.isIntersecting;
            }
            apply();
          },
          { rootMargin: "0px", threshold: 0 },
        );
        footerObserver.observe(footer);
      })();
    </script>

    <script is:inline>

      // 1. Year-stamp.
      (function () {
        const y = document.getElementById("y");
        if (y) y.textContent = String(new Date().getFullYear());
      })();

      // 2. Hardening helpers.
      function stripControls(s) {
        return String(s || "")
          .replace(/[\u0000-\u001F\u007F]/g, " ")
          .trim();
      }
      function normalizeSpaces(s) {
        return stripControls(s).replace(/\s+/g, " ").trim();
      }
      function safeBodyText(s) {
        // C0/C1 controls + bidi-overrides + zero-width chars stripped so
        // operator's notification email can't be visually spoofed.
        return String(s || "")
          .replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F\u200B-\u200F\u202A-\u202E\u2028-\u2029\u2060\uFEFF]/g, "")
          .slice(0, 2000);
      }
      function isValidName(name) {
        const n = normalizeSpaces(name);
        if (n.length < 2 || n.length > 60) return false;
        const re = /^\p{L}[\p{L}\p{M}\s'’-]{0,58}\p{L}$/u;
        return re.test(n);
      }
      function isValidEmail(emailEl) {
        const e = normalizeSpaces(emailEl.value);
        if (e.length < 6 || e.length > 254) return false;
        if (/\s/.test(e)) return false;
        if (!emailEl.checkValidity()) return false;
        const parts = e.split("@");
        if (parts.length !== 2) return false;
        if (parts[0].length > 64 || parts[0].length < 1) return false;
        if (parts[1].length < 3 || !parts[1].includes(".")) return false;
        return true;
      }
      function isValidPhoneLocal(phone) {
        const raw = String(phone || "").trim();
        if (!raw) return true;
        if (!/^[0-9\s()\-]+$/.test(raw)) return false;
        const digits = raw.replace(/\D/g, "");
        return digits.length >= 4 && digits.length <= 14;
      }

      // 3. FAQ accordion — single-open.
      (function initFAQ() {
        const faqButtons = Array.from(document.querySelectorAll(".faq-q"));
        if (!faqButtons.length) return;
        function closeAll(exceptId) {
          for (const btn of faqButtons) {
            const panelId = btn.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            const isExcept = btn.id === exceptId;
            if (!isExcept) {
              btn.setAttribute("aria-expanded", "false");
              if (panel) panel.hidden = true;
            }
          }
        }
        for (const btn of faqButtons) {
          btn.addEventListener("click", () => {
            const expanded = btn.getAttribute("aria-expanded") === "true";
            const panelId = btn.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (!panel) return;
            if (expanded) {
              btn.setAttribute("aria-expanded", "false");
              panel.hidden = true;
              return;
            }
            closeAll(btn.id);
            btn.setAttribute("aria-expanded", "true");
            panel.hidden = false;
          });
        }
      })();

      // 4. Country code type-ahead picker.
      (function initCountryCodePicker() {
        const search = document.getElementById("ccSearch");
        const list = document.getElementById("ccList");
        const optionsHost = document.getElementById("ccOptions");
        const ccDial = document.getElementById("ccDial");
        const ccISO2 = document.getElementById("ccISO2");
        const ccISO3 = document.getElementById("ccISO3");
        const wrap = search ? search.closest(".cc-wrap") : null;
        if (!search || !list || !optionsHost || !ccDial || !ccISO2 || !ccISO3) return;

        const COUNTRY_CODES = [
          { iso2: "AU", iso3: "AUS", dial: "+61", name: "Australia" },
          { iso2: "NZ", iso3: "NZL", dial: "+64", name: "New Zealand" },
          { iso2: "US", iso3: "USA", dial: "+1", name: "United States" },
          { iso2: "CA", iso3: "CAN", dial: "+1", name: "Canada" },
          { iso2: "GB", iso3: "GBR", dial: "+44", name: "United Kingdom" },
          { iso2: "IE", iso3: "IRL", dial: "+353", name: "Ireland" },
          { iso2: "DE", iso3: "DEU", dial: "+49", name: "Germany" },
          { iso2: "FR", iso3: "FRA", dial: "+33", name: "France" },
          { iso2: "ES", iso3: "ESP", dial: "+34", name: "Spain" },
          { iso2: "IT", iso3: "ITA", dial: "+39", name: "Italy" },
          { iso2: "NL", iso3: "NLD", dial: "+31", name: "Netherlands" },
          { iso2: "BE", iso3: "BEL", dial: "+32", name: "Belgium" },
          { iso2: "CH", iso3: "CHE", dial: "+41", name: "Switzerland" },
          { iso2: "AT", iso3: "AUT", dial: "+43", name: "Austria" },
          { iso2: "SE", iso3: "SWE", dial: "+46", name: "Sweden" },
          { iso2: "NO", iso3: "NOR", dial: "+47", name: "Norway" },
          { iso2: "DK", iso3: "DNK", dial: "+45", name: "Denmark" },
          { iso2: "FI", iso3: "FIN", dial: "+358", name: "Finland" },
          { iso2: "SG", iso3: "SGP", dial: "+65", name: "Singapore" },
          { iso2: "JP", iso3: "JPN", dial: "+81", name: "Japan" },
          { iso2: "KR", iso3: "KOR", dial: "+82", name: "South Korea" },
          { iso2: "IN", iso3: "IND", dial: "+91", name: "India" },
          { iso2: "CN", iso3: "CHN", dial: "+86", name: "China" },
          { iso2: "AE", iso3: "ARE", dial: "+971", name: "United Arab Emirates" },
          { iso2: "ZA", iso3: "ZAF", dial: "+27", name: "South Africa" },
          { iso2: "BR", iso3: "BRA", dial: "+55", name: "Brazil" },
          { iso2: "ID", iso3: "IDN", dial: "+62", name: "Indonesia" },
        ];

        // No emoji flags — picker text echoes into the operator's
        // notification email; emoji renders inconsistently across clients
        // and undercuts a senior-advisory premise.
        function formatItem(c) {
          return `${c.dial}  ${c.iso3} — ${c.name}`;
        }
        const defaultAU = COUNTRY_CODES.find((c) => c.iso2 === "AU") || COUNTRY_CODES[0];
        const defaultDisplay = formatItem(defaultAU);

        function openList() {
          list.style.display = "block";
          search.setAttribute("aria-expanded", "true");
        }
        function closeList() {
          list.style.display = "none";
          search.setAttribute("aria-expanded", "false");
        }
        function setSelection(c) {
          ccDial.value = c.dial;
          ccISO2.value = c.iso2;
          ccISO3.value = c.iso3;
          search.value = formatItem(c);
          closeList();
        }
        function isFormattedDisplay(value) {
          // The formatted display value of the selected country contains
          // chars (dial + em-dash) that do not appear in the haystack, so
          // a literal includes() check would return zero matches on first
          // focus. Treat "field still shows the selected formatted text"
          // as no-query so the dropdown shows the full list.
          const trimmed = String(value || "").trim();
          if (!trimmed) return true;
          const selected =
            COUNTRY_CODES.find((c) => c.iso2 === ccISO2.value) || defaultAU;
          return (
            trimmed === defaultDisplay || trimmed === formatItem(selected)
          );
        }
        function filter(q) {
          if (isFormattedDisplay(q)) return COUNTRY_CODES;
          const query = normalizeSpaces(q).toUpperCase();
          if (!query) return COUNTRY_CODES;
          return COUNTRY_CODES.filter((c) => {
            const hay = `${c.name} ${c.iso2} ${c.iso3} ${c.dial}`.toUpperCase();
            return hay.includes(query);
          });
        }
        function render(filtered) {
          optionsHost.innerHTML = "";
          const items = filtered.slice(0, 30);
          for (const c of items) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "cc-option";
            btn.textContent = formatItem(c);
            btn.addEventListener("click", () => setSelection(c));
            optionsHost.appendChild(btn);
          }
          if (!items.length) {
            const empty = document.createElement("div");
            empty.className = "micro";
            empty.textContent = "No matches.";
            optionsHost.appendChild(empty);
          }
        }

        search.value = defaultDisplay;
        render(COUNTRY_CODES);

        function visibleOptions() {
          return Array.from(optionsHost.querySelectorAll(".cc-option"));
        }
        function focusOption(index) {
          const opts = visibleOptions();
          if (!opts.length) return;
          const clamped = Math.max(0, Math.min(opts.length - 1, index));
          opts[clamped].focus();
        }

        search.addEventListener("focus", () => {
          render(filter(search.value));
          openList();
        });
        search.addEventListener("input", () => {
          render(filter(search.value));
          openList();
        });
        // ARIA 1.2 combobox keyboard contract on the search input:
        // ArrowDown opens (if closed) and moves focus into the listbox;
        // ArrowUp focuses the last option; Home/End jump to bounds;
        // Escape closes the list.
        search.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closeList();
            return;
          }
          if (e.key === "ArrowDown") {
            e.preventDefault();
            openList();
            focusOption(0);
            return;
          }
          if (e.key === "ArrowUp") {
            e.preventDefault();
            openList();
            const opts = visibleOptions();
            focusOption(opts.length - 1);
            return;
          }
          if (e.key === "Home") {
            e.preventDefault();
            focusOption(0);
            return;
          }
          if (e.key === "End") {
            e.preventDefault();
            const opts = visibleOptions();
            focusOption(opts.length - 1);
            return;
          }
        });
        // Roving-focus keyboard nav on the options themselves: Arrow keys
        // move focus among options; Home/End jump; Escape returns focus
        // to the search input and closes; Enter is handled natively by
        // button activation, which triggers setSelection via the existing
        // click handler.
        optionsHost.addEventListener("keydown", (e) => {
          const opts = visibleOptions();
          const currentIndex = opts.indexOf(document.activeElement);
          if (e.key === "ArrowDown") {
            e.preventDefault();
            focusOption(currentIndex + 1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            if (currentIndex <= 0) {
              search.focus();
            } else {
              focusOption(currentIndex - 1);
            }
          } else if (e.key === "Home") {
            e.preventDefault();
            focusOption(0);
          } else if (e.key === "End") {
            e.preventDefault();
            focusOption(opts.length - 1);
          } else if (e.key === "Escape") {
            e.preventDefault();
            closeList();
            search.focus();
          }
        });
        document.addEventListener("click", (e) => {
          // Containment check (not strict equality) so clicks on the
          // wrapper padding / label don't immediately re-close the list.
          const inside = wrap && wrap.contains(e.target);
          if (!inside) closeList();
        });

        // Expose a reset hook so the form-handler can restore the AU
        // default display after form.reset() wipes the search input.
        window.__capitaResetCountryPicker = function () {
          ccDial.value = defaultAU.dial;
          ccISO2.value = defaultAU.iso2;
          ccISO3.value = defaultAU.iso3;
          search.value = defaultDisplay;
          render(COUNTRY_CODES);
        };
      })();

      // 5. Form validate + Formspree POST.
      (function initLeadForm() {
        const FORMSPREE_ENDPOINT = "https://formspree.io/f/xojdzarv";
        const form = document.getElementById("leadForm");
        if (!form) return;
        const err = document.getElementById("formError");
        const ok = document.getElementById("formSuccess");
        const nameEl = document.getElementById("name");
        const emailEl = document.getElementById("email");
        const phoneEl = document.getElementById("phone");
        const msgEl = document.getElementById("message");
        const ccDial = document.getElementById("ccDial");
        const ccISO3 = document.getElementById("ccISO3");
        const submitBtn = form.querySelector('button[type="submit"]');
        let pending = false;

        function setError(m) {
          if (!err) return;
          err.textContent = m || "";
          if (ok) ok.textContent = "";
        }
        function setFieldError(fieldId, message) {
          const input = document.getElementById(fieldId);
          const slot = document.getElementById("error-" + fieldId);
          if (input) input.setAttribute("aria-invalid", "true");
          if (slot) {
            slot.textContent = message;
            slot.hidden = false;
          }
        }
        function clearFieldError(fieldId) {
          const input = document.getElementById(fieldId);
          const slot = document.getElementById("error-" + fieldId);
          if (input) input.removeAttribute("aria-invalid");
          if (slot) {
            slot.textContent = "";
            slot.hidden = true;
          }
        }
        function clearAllFieldErrors() {
          for (const id of ["name", "email", "phone"]) clearFieldError(id);
        }
        // Per-field errors clear on next input keystroke (per the per-field
        // error lifecycle decision: errors persist until the user starts
        // correcting, not on every keystroke and not only at re-submit).
        for (const id of ["name", "email", "phone"]) {
          const el = document.getElementById(id);
          if (el) el.addEventListener("input", function () { clearFieldError(id); });
        }
        function setSuccess(m) {
          // textContent + DOM-built <strong> instead of innerHTML so any
          // future contributor extending this with a non-static message
          // can't accidentally introduce XSS.
          if (!ok) return;
          ok.innerHTML = "";
          if (m) {
            const strong = document.createElement("strong");
            strong.textContent = m;
            ok.appendChild(strong);
          }
          if (err) err.textContent = "";
        }
        function setPending(value) {
          pending = value;
          if (submitBtn) {
            submitBtn.disabled = value;
            submitBtn.textContent = value ? "Sending…" : "Send enquiry";
          }
        }

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (pending) return;
          setError("");
          clearAllFieldErrors();

          const hp = form.querySelector('input[name="company"]')?.value;
          if (hp && hp.trim().length) return;

          if (!nameEl || !emailEl) {
            setError("Form is missing required fields.");
            return;
          }
          const name = normalizeSpaces(nameEl.value);
          const email = normalizeSpaces(emailEl.value);
          const phone = normalizeSpaces(phoneEl ? phoneEl.value : "");
          const message = safeBodyText(msgEl ? msgEl.value : "");

          // Collect per-field errors first, then short-circuit if any fired
          // so the user sees every problem at once rather than fixing them
          // sequentially.
          let hasFieldError = false;
          if (!nameEl.checkValidity() || !isValidName(name)) {
            setFieldError(
              "name",
              "Name must be 2–60 characters of letters (and spaces, apostrophes, or hyphens).",
            );
            hasFieldError = true;
          }
          if (!emailEl.checkValidity() || !isValidEmail(emailEl)) {
            setFieldError("email", "Enter a valid email address.");
            hasFieldError = true;
          }
          if (!isValidPhoneLocal(phone)) {
            setFieldError(
              "phone",
              "Phone must contain digits only (spaces/dashes allowed) and be 4–14 digits.",
            );
            hasFieldError = true;
          }
          if (hasFieldError) {
            setError("Complete the highlighted fields and try again.");
            return;
          }

          const dial = stripControls(ccDial ? ccDial.value : "+61") || "+61";
          const iso3 = stripControls(ccISO3 ? ccISO3.value : "AUS") || "AUS";
          const fullPhone = phone ? `${dial} (${iso3}) ${phone}` : "";

          const payload = { name, email, phone: fullPhone, message };

          setPending(true);
          // 30s ceiling so a stalled Formspree edge can't leave the user
          // waiting indefinitely with no signal.
          const ctl = AbortSignal.timeout ? { signal: AbortSignal.timeout(30000) } : {};

          try {
            const res = await fetch(FORMSPREE_ENDPOINT, {
              method: "POST",
              headers: { Accept: "application/json", "Content-Type": "application/json" },
              body: JSON.stringify(payload),
              ...ctl,
            });

            if (res.status === 429) {
              setError("Too many submissions in a short window. Try again in a few minutes or email consulting@capitatech.com.au.");
              return;
            }
            if (!res.ok) {
              setError("Submission failed. Try again or email consulting@capitatech.com.au.");
              return;
            }

            form.reset();
            clearAllFieldErrors();
            // form.reset() wipes the search input on the country picker;
            // restore the AU default display + hidden field values so the
            // next prospect sees the same starting state.
            if (typeof window.__capitaResetCountryPicker === "function") {
              window.__capitaResetCountryPicker();
            }
            setSuccess("Thank you. We will respond shortly.");
          } catch (caught) {
            const isAbort = caught && caught.name === "AbortError";
            setError(
              isAbort
                ? "Submission timed out. Try again or email consulting@capitatech.com.au."
                : "Network error. Try again or email consulting@capitatech.com.au."
            );
          } finally {
            setPending(false);
          }
        });
      })();
    </script>
  </body>
</html>
