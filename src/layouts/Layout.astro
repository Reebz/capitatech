          }
          if (!emailEl.checkValidity() || !isValidEmail(emailEl)) {
            setFieldError("email", "Enter a valid email address.");
            hasFieldError = true;
          }
          if (!companyEl.checkValidity() || !isValidFreeText(company, 2, 120)) {
            setFieldError("company", "Company must be 2–120 characters.");
            hasFieldError = true;
          }
          if (!roleEl.checkValidity() || !isValidFreeText(role, 2, 120)) {
            setFieldError("role", "Role must be 2–120 characters.");
            hasFieldError = true;
          }
          if (!isValidPhoneLocal(phone)) {
