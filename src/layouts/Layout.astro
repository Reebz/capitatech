---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
import { generateAscii } from "../lib/asciiGrid";

// Critical font subsets — preloaded so the WOFF2s are in flight with the
// HTML response instead of waiting for the CSS parser to discover the
// @font-face declarations. Without this, the page renders in system
// sans-serif, then swaps to Inter/Geist after CSS + WOFF2 round-trip —
// painfully visible at H1 144px and kinetic 168px. Only the latin
// subsets preload (English-only content); other subsets stay lazy.
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import geistLatinUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Capita Technology. Advisory for boards and executives.",
  description = "Capita Technology helps boards and executives with AI strategy and delivery, customer retention and growth, and productivity. Principal-led, independent advisory. Engagements scoped and priced from $35,000. Bespoke advisory on request.",
} = Astro.props;

// Server-rendered ASCII grid (shared generator in lib/asciiGrid). Generous
// size to cover ultrawide displays at the smallest font-size in the clamp;
// CSS clips the bleed via overflow:hidden. The hero-scoped spotlight layer
// (index.astro) renders the same texture from the same generator.
const ASCII_COLS = 320;
const ASCII_ROWS = 80;
const ascii = generateAscii(ASCII_COLS, ASCII_ROWS);
---

<!doctype html>
<html lang="en" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0a6fe0" />

    {/* Font preloads — placed BEFORE the stylesheet link so the WOFF2
        requests start in parallel with CSS parsing instead of after.
        crossorigin is required for woff2 served from the same origin
        with CORS-safe headers; without it the browser fires a second
        request when the @font-face rule matches. */}
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatinUrl} as="font" type="font/woff2" crossorigin />

    {/* Open Graph + Twitter Card meta. og:image and twitter:image are
        absolute URLs because the OG protocol requires it. The same static
        1200×630 PNG serves both LinkedIn (large card) and X
        (summary_large_image). */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Capita Technology" />
    <link rel="canonical" href="https://capitatech.com.au/" />
    <meta property="og:url" content="https://capitatech.com.au/" />
    <meta property="og:image" content="https://capitatech.com.au/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://capitatech.com.au/og-image.png" />

    {/* Favicon set + manifest. SVG is the primary icon (sharp at every
        size); raster fallbacks cover legacy browsers and iOS home-screen. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <title>{title}</title>

    <script is:inline>
      // HTTPS redirect (runs before paint). Defense in depth — Vercel's edge
      // also redirects HTTP → HTTPS. The bypass list covers localhost,
      // 127.0.0.1, *.local (portless TLD), AND *.localhost so dev URLs in
      // any common shape are unaffected.
      (function () {
        const h = location.hostname;
        const isLocal =
          h === "localhost" ||
          h === "127.0.0.1" ||
          h.endsWith(".local") ||
          h.endsWith(".localhost");
        if (!isLocal && location.protocol !== "https:") {
          location.replace(
            "https://" + location.host + location.pathname + location.search + location.hash
          );
        }
      })();
    </script>
  </head>

  <body>
    <pre id="ascii-grid" class="ascii-grid" aria-hidden="true">{ascii}</pre>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header layer-fg" id="top">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="Capita Technology">
          <span class="brand-text">Capita<span style="color: var(--text)">.</span>Technology</span>
        </a>

        {/* Right cluster: the collapsible link list (#primaryNav), the always-
            visible "Talk to us" CTA, and the mobile hamburger. The CTA and the
            toggle are SIBLINGS of #primaryNav — not children — so when the panel
            collapses to display:none at <=840px the CTA stays in the bar. */}
        <div class="header-right">
          <nav class="nav" id="primaryNav" aria-label="Primary">
            <a href="#packages">Services</a>
            <a href="#bespoke">Bespoke</a>
            <a href="#outcomes">Outcomes</a>
            <a href="#operating-method">Method</a>
            <a href="#faq">FAQ</a>
          </nav>

          <a class="nav-cta" href="#contact">Talk to us</a>

          <button
            id="navToggle"
            class="nav-toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="primaryNav"
          >
            <span class="nav-toggle-glyph" aria-hidden="true">☰</span>
          </button>
        </div>
      </div>
    </header>

    <div class="layer-fg"><slot /></div>

    <footer class="site-footer layer-fg" aria-label="Footer">
      <div class="footer-band" aria-hidden="true">
        <span class="footer-mark">Capita</span>
      </div>
      <div class="container">
        <div class="footer-inner">
          <p>© <span id="y"></span> Capita Technology. Advisory by ex-operators.</p>
          <div class="footer-links">
            <a href="#top">Top</a>
            <a href="#packages">Services</a>
            <a href="#outcomes">Outcomes</a>
            <a href="#faq">FAQ</a>
            <a href="#contact">Talk to us</a>
          </div>
        </div>

        {/* Visually-hidden group heading so the footer tile <h3>s have a
            parent <h2> in the document outline (no sr-only utility exists in
            global.css, so the clip pattern is inlined on this one element —
            zero visible change, lowest-disruption outline fix). */}
        <h2 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Capita Technology details</h2>
        <div class="footer-tiles">
          <div class="tile">
            <h3>Contact</h3>
            <p class="micro">consulting@capitatech.com.au</p>
            <p class="micro">Sydney, NSW · Working with boards across Australia, New Zealand, and Southeast Asia.</p>
          </div>
          <div class="tile">
            <h3>Engagements</h3>
            <p class="micro">Diagnosis · Operating model · Roadmap · Measurement · Bespoke</p>
          </div>
          <div class="tile">
            <h3>Industries</h3>
            <p class="micro">Telco · Banking · Insurance · Property · SaaS</p>
          </div>
        </div>

        <p class="footer-nda micro">All work delivered under mutual NDA.</p>
      </div>
    </footer>

    {/* Back-to-top button — position:fixed bottom-right. Hidden by default,
        revealed after the user scrolls past the hero (reuses the
        #grid-calm-sentinel observer). Smooth scroll respects reduced-motion. */}
    <button
      id="back-to-top"
      class="back-to-top"
      type="button"
      aria-label="Back to top"
      hidden
    >
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M 10 4 L 4 11 M 10 4 L 16 11 M 10 4 L 10 17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script is:inline>
      // ASCII spotlight + idle drift + two-tier grid intensity.
      // Mirrors the Cavaro mechanism with mid-session matchMedia listeners
      // and Page Visibility handling that Cavaro's one-time check lacks.
      (function initSpotlight() {
        const grid = document.getElementById("ascii-grid");
        if (!grid) return;

        const reducedMotionMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
        const cursorMQ = window.matchMedia("(hover: hover) and (pointer: fine)");
        let reducedMotion = reducedMotionMQ.matches;
        let hasCursor = cursorMQ.matches;
        let idleActive = !hasCursor;
        let rafId = 0;
        let idleStart = performance.now();

        function setPos(x, y) {
          // Written to :root (documentElement) so both the fixed page grid and
          // the hero-scoped .hero-ascii layer read the same spotlight position.
          document.documentElement.style.setProperty("--mx", x + "px");
          document.documentElement.style.setProperty("--my", y + "px");
        }

        function clearGradient() {
          // Removes the spotlight position so CSS falls back to the flat
          // dot tint only — used under reduced-motion.
          document.documentElement.style.removeProperty("--mx");
          document.documentElement.style.removeProperty("--my");
        }

        function idleLoop(now) {
          if (reducedMotion || !idleActive) return;
          // Lissajous orbit, asymmetric X/Y so the path doesn't repeat
          // visibly within a session. X period ~4500ms, Y at 0.7× freq.
          const t = (now - idleStart) / 4500;
          const w = window.innerWidth;
          const h = window.innerHeight;
          const cx = w / 2;
          const cy = h / 2;
          const radius = Math.min(w, h) * 0.42;
          const x = cx + Math.cos(t * 2 * Math.PI) * radius;
          const y = cy + Math.sin(t * 2 * Math.PI * 0.7) * radius * 0.65;
          setPos(x, y);
          rafId = requestAnimationFrame(idleLoop);
        }

        function startIdle() {
          if (reducedMotion) return;
          idleActive = true;
          idleStart = performance.now();
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(idleLoop);
        }

        function stopIdle() {
          idleActive = false;
          cancelAnimationFrame(rafId);
        }

        function applyMotionState() {
          if (reducedMotion) {
            stopIdle();
            clearGradient();
            return;
          }
          if (hasCursor) {
            // Wait for first mousemove; idle drift fills the gap.
            startIdle();
          } else {
            startIdle();
          }
        }

        function onMouseMove(e) {
          if (reducedMotion) return;
          stopIdle();
          // Single rAF coalesces multi-events-per-frame from high-Hz mice.
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(function () {
            setPos(e.clientX, e.clientY);
          });
        }

        function onMouseLeave() {
          if (reducedMotion || !hasCursor) return;
          startIdle();
        }

        function attachCursorListeners() {
          if (!hasCursor) return;
          window.addEventListener("mousemove", onMouseMove, { passive: true });
          document.addEventListener("mouseleave", onMouseLeave);
        }

        function detachCursorListeners() {
          window.removeEventListener("mousemove", onMouseMove);
          document.removeEventListener("mouseleave", onMouseLeave);
        }

        // Initial wiring.
        applyMotionState();
        attachCursorListeners();

        // Mid-session reactivity: OS reduced-motion toggle and cursor
        // capability change (e.g., iPad keyboard connect) update state
        // within one frame without a page reload.
        reducedMotionMQ.addEventListener("change", function (e) {
          reducedMotion = e.matches;
          applyMotionState();
        });
        cursorMQ.addEventListener("change", function (e) {
          const wasCursor = hasCursor;
          hasCursor = e.matches;
          if (wasCursor && !hasCursor) {
            detachCursorListeners();
          } else if (!wasCursor && hasCursor) {
            attachCursorListeners();
          }
          applyMotionState();
        });

        // Page Visibility: reset idle clock when the tab is restored from
        // background so the Lissajous position doesn't skip. rAF is paused
        // by the browser when the tab is hidden; without this, the next
        // frame would compute against a stale `idleStart`.
        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState === "visible" && idleActive && !reducedMotion) {
            idleStart = performance.now();
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(idleLoop);
          }
        });
      })();

      // Kinetic phrase scroll-driven horizontal travel. Each .kinetic-phrase
      // band gets an IntersectionObserver that attaches a scroll handler
      // when the band enters the viewport. The handler computes band-center
      // vs viewport-center as a -1..+1 progress value and writes it to a
      // --kinetic-progress CSS custom property; CSS reads the property to
      // apply translateX. Reduced-motion gates the attach — no scroll
      // listener fires under reduced motion.
      (function initKineticPhrase() {
        const bands = document.querySelectorAll(".kinetic-phrase");
        if (!bands.length) return;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reducedMotion) return;

        const tracked = new Set();
        let scrollRaf = 0;

        function updateBand(band) {
          const rect = band.getBoundingClientRect();
          const viewportCenter = window.innerHeight / 2;
          const bandCenter = rect.top + rect.height / 2;
          // Distance from viewport center, normalized by half-viewport-height
          // so progress is roughly -1..+1 across the natural scroll arc.
          const range = window.innerHeight / 2 + rect.height / 2;
          const progress = (viewportCenter - bandCenter) / range;
          const clamped = Math.max(-1, Math.min(1, progress));
          band.style.setProperty("--kinetic-progress", String(clamped));
        }

        function onScroll() {
          if (scrollRaf) return;
          scrollRaf = requestAnimationFrame(function () {
            scrollRaf = 0;
            for (const band of tracked) updateBand(band);
          });
        }

        const observer = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                tracked.add(entry.target);
                updateBand(entry.target);
              } else {
                tracked.delete(entry.target);
              }
            }
            // Toggle listener based on whether anything is currently visible.
            if (tracked.size > 0) {
              window.addEventListener("scroll", onScroll, { passive: true });
            } else {
              window.removeEventListener("scroll", onScroll);
            }
          },
          { rootMargin: "20% 0px 20% 0px", threshold: 0 },
        );
        for (const band of bands) observer.observe(band);
      })();

      // Back-to-top button: revealed after the hero-end sentinel exits the
      // viewport top. Click scrolls to top — smoothly by default, instantly
      // under prefers-reduced-motion. Focus returns to the brand link in
      // the header after activation so a keyboard user re-enters the page
      // at the top rather than being stranded on an invisible button.
      (function initBackToTop() {
        const btn = document.getElementById("back-to-top");
        const sentinel = document.getElementById("grid-calm-sentinel");
        const brandLink = document.querySelector(".brand");
        if (!btn || !sentinel) return;

        const observer = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                btn.classList.remove("visible");
                btn.hidden = true;
              } else if (entry.boundingClientRect.top < 0) {
                btn.hidden = false;
                // Force a frame so the transition fires from the hidden state.
                requestAnimationFrame(function () {
                  btn.classList.add("visible");
                });
              }
            }
          },
          { rootMargin: "0px", threshold: 0 },
        );
        observer.observe(sentinel);

        btn.addEventListener("click", function () {
          const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          window.scrollTo({
            top: 0,
            behavior: reducedMotion ? "auto" : "smooth",
          });
          // Move focus to the brand link in the header so the next Tab
          // enters the page from the top. Done after a short delay so the
          // scroll has a chance to land before focus changes.
          if (brandLink) {
            setTimeout(function () {
              brandLink.focus();
            }, reducedMotion ? 0 : 500);
          }
        });
      })();

      // Two-tier grid intensity: body.grid-calm flips when the user has
      // scrolled past the hero AND the footer is not yet in view. Hero +
      // footer remain at full intensity; body sections (logo grid, method,
      // outcomes, FAQ, contact) read the calmed tint via CSS.
      (function initGridIntensity() {
        const sentinel = document.getElementById("grid-calm-sentinel");
        const footer = document.querySelector(".site-footer");
        if (!sentinel || !footer) return;

        let heroExited = false;
        let footerInView = false;

        function apply() {
          // Calm when past hero AND footer not yet visible.
          if (heroExited && !footerInView) {
            document.body.classList.add("grid-calm");
          } else {
            document.body.classList.remove("grid-calm");
          }
        }

        // Sentinel sits at the end of the hero. When it scrolls above the
        // viewport top, the user has read past the hero.
        const heroObserver = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              // `isIntersecting` flips when the sentinel enters/exits the
              // viewport. We want "above the viewport top" which manifests
              // as boundingClientRect.top < 0 when not intersecting.
              if (entry.isIntersecting) {
                heroExited = false;
              } else if (entry.boundingClientRect.top < 0) {
                heroExited = true;
              }
            }
            apply();
          },
          { rootMargin: "0px", threshold: 0 },
        );
        heroObserver.observe(sentinel);

        // Footer observer: when the footer enters viewport (even partially),
        // return to full intensity so its closing band reads.
        const footerObserver = new IntersectionObserver(
          function (entries) {
            for (const entry of entries) {
              footerInView = entry.isIntersecting;
            }
            apply();
          },
          { rootMargin: "0px", threshold: 0 },
        );
        footerObserver.observe(footer);
      })();

      // Mobile nav toggle: the hamburger flips a data-nav-open attribute on
      // the <header> (CSS turns #primaryNav into a dropdown panel at
      // max-width:840px) and keeps aria-expanded in sync. The panel closes on
      // Escape, on tapping any nav link, and on an outside click. Tiny and
      // dependency-free, matching the other inline behaviors here.
      (function initMobileNav() {
        const toggle = document.getElementById("navToggle");
        const header = document.getElementById("top");
        const panel = document.getElementById("primaryNav");
        if (!toggle || !header || !panel) return;

        function setOpen(open) {
          if (open) {
            header.setAttribute("data-nav-open", "");
          } else {
            header.removeAttribute("data-nav-open");
          }
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }
        function isOpen() {
          return header.hasAttribute("data-nav-open");
        }

        toggle.addEventListener("click", function () {
          setOpen(!isOpen());
        });
        // Close after a nav link is chosen so the panel doesn't sit over the
        // section the user just jumped to.
        panel.addEventListener("click", function (e) {
          if (e.target && e.target.closest("a")) setOpen(false);
        });
        // Escape closes and returns focus to the toggle.
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && isOpen()) {
            setOpen(false);
            toggle.focus();
          }
        });
        // Outside click closes (taps on the toggle or inside the panel don't).
        document.addEventListener("click", function (e) {
          if (!isOpen()) return;
          if (toggle.contains(e.target) || panel.contains(e.target)) return;
          setOpen(false);
        });
      })();
    </script>

    <script is:inline>

      // 1. Year-stamp.
      (function () {
        const y = document.getElementById("y");
        if (y) y.textContent = String(new Date().getFullYear());
      })();

      // 2. Hardening helpers.
      function stripControls(s) {
        return String(s || "")
          .replace(/[\u0000-\u001F\u007F]/g, " ")
          .trim();
      }
      function normalizeSpaces(s) {
        return stripControls(s).replace(/\s+/g, " ").trim();
      }
      function safeBodyText(s) {
        // C0/C1 controls + bidi-overrides + zero-width chars stripped so
        // operator's notification email can't be visually spoofed.
        return String(s || "")
          .replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F\u200B-\u200F\u202A-\u202E\u2028-\u2029\u2060\uFEFF]/g, "")
          .slice(0, 2000);
      }
      function isValidName(name) {
        const n = normalizeSpaces(name);
        if (n.length < 2 || n.length > 60) return false;
        const re = /^\p{L}[\p{L}\p{M}\s'’-]{0,58}\p{L}$/u;
        return re.test(n);
      }
      function isValidEmail(emailEl) {
        const e = normalizeSpaces(emailEl.value);
        if (e.length < 6 || e.length > 254) return false;
        if (/\s/.test(e)) return false;
        if (!emailEl.checkValidity()) return false;
        const parts = e.split("@");
        if (parts.length !== 2) return false;
        if (parts[0].length > 64 || parts[0].length < 1) return false;
        if (parts[1].length < 3 || !parts[1].includes(".")) return false;
        return true;
      }
      function isValidPhoneLocal(phone) {
        const raw = String(phone || "").trim();
        if (!raw) return true;
        // Allows an optional leading "+" and the full international number
        // (country code included), since the country-code picker is gone.
        if (!/^\+?[0-9\s()\-]+$/.test(raw)) return false;
        const digits = raw.replace(/\D/g, "");
        return digits.length >= 6 && digits.length <= 15;
      }
      function isValidFreeText(value, min, max) {
        const v = normalizeSpaces(value);
        return v.length >= min && v.length <= max;
      }
      // Allowed package slugs — keep in sync with the <select> in the
      // contact form. Any value outside this set falls back to "not-sure"
      // so the operator's notification email never carries a tampered
      // value from a manipulated form payload.
      const PACKAGE_SLUGS = ["not-sure", "om-and-a", "diagnosis", "roadmap", "measurement", "bespoke"];
      function normalizePackage(value) {
        const v = stripControls(value);
        return PACKAGE_SLUGS.includes(v) ? v : "not-sure";
      }

      // 3. FAQ accordion — single-open.
      (function initFAQ() {
        const faqButtons = Array.from(document.querySelectorAll(".faq-q"));
        if (!faqButtons.length) return;
        function closeAll(exceptId) {
          for (const btn of faqButtons) {
            const panelId = btn.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            const isExcept = btn.id === exceptId;
            if (!isExcept) {
              btn.setAttribute("aria-expanded", "false");
              if (panel) panel.hidden = true;
            }
          }
        }
        for (const btn of faqButtons) {
          btn.addEventListener("click", () => {
            const expanded = btn.getAttribute("aria-expanded") === "true";
            const panelId = btn.getAttribute("aria-controls");
            const panel = panelId ? document.getElementById(panelId) : null;
            if (!panel) return;
            if (expanded) {
              btn.setAttribute("aria-expanded", "false");
              panel.hidden = true;
              return;
            }
            closeAll(btn.id);
            btn.setAttribute("aria-expanded", "true");
            panel.hidden = false;
          });
        }
      })();

      // 4. Country-code picker removed — phone is now a single optional field
      // that accepts the full international number (country code included), so
      // the type-ahead combobox and its hidden dial/ISO fields are gone.

      // 5. Form validate + Formspree POST.
      (function initLeadForm() {
        const FORMSPREE_ENDPOINT = "https://formspree.io/f/xojdzarv";
        const form = document.getElementById("leadForm");
        if (!form) return;
        const err = document.getElementById("formError");
        const ok = document.getElementById("formSuccess");
        const nameEl = document.getElementById("name");
        const emailEl = document.getElementById("email");
        const companyEl = document.getElementById("company");
        const phoneEl = document.getElementById("phone");
        const packageEl = document.getElementById("package");
        const msgEl = document.getElementById("message");
        const submitBtn = form.querySelector('button[type="submit"]');
        let pending = false;

        function setError(m) {
          if (!err) return;
          err.textContent = m || "";
          if (ok) ok.textContent = "";
        }
        function setFieldError(fieldId, message) {
          const input = document.getElementById(fieldId);
          const slot = document.getElementById("error-" + fieldId);
          if (input) input.setAttribute("aria-invalid", "true");
          if (slot) {
            slot.textContent = message;
            slot.hidden = false;
          }
        }
        function clearFieldError(fieldId) {
          const input = document.getElementById(fieldId);
          const slot = document.getElementById("error-" + fieldId);
          if (input) input.removeAttribute("aria-invalid");
          if (slot) {
            slot.textContent = "";
            slot.hidden = true;
          }
        }
        function clearAllFieldErrors() {
          for (const id of ["name", "email", "company", "phone"]) clearFieldError(id);
        }
        // Per-field errors clear on next input keystroke (per the per-field
        // error lifecycle decision: errors persist until the user starts
        // correcting, not on every keystroke and not only at re-submit).
        for (const id of ["name", "email", "company", "phone"]) {
          const el = document.getElementById(id);
          if (el) el.addEventListener("input", function () { clearFieldError(id); });
        }

        // Single source of truth for per-field validity — the exact same
        // predicates and copy the submit pass uses, so blur-time and
        // submit-time validation can never drift. Returns true when valid.
        // An empty field is treated as not-yet-validated on blur (no error
        // shown for a field the user merely tabbed through) — the submit
        // pass still enforces presence via checkValidity(required).
        function validateField(id) {
          const el = document.getElementById(id);
          if (!el) return true;
          if (id === "phone") {
            const phone = normalizeSpaces(el.value);
            if (!isValidPhoneLocal(phone)) {
              setFieldError(
                "phone",
                "Phone can include +, spaces and dashes, and must be 6 to 15 digits.",
              );
              return false;
            }
            clearFieldError("phone");
            return true;
          }
          // Don't nag on an empty optional-looking field at blur; let submit
          // handle required-but-empty so tabbing through stays quiet.
          if (!String(el.value || "").trim()) {
            clearFieldError(id);
            return true;
          }
          if (id === "name") {
            const name = normalizeSpaces(el.value);
            if (!el.checkValidity() || !isValidName(name)) {
              setFieldError(
                "name",
                "Name must be 2–60 characters of letters (and spaces, apostrophes, or hyphens).",
              );
              return false;
            }
          } else if (id === "email") {
            if (!el.checkValidity() || !isValidEmail(el)) {
              setFieldError("email", "Enter a valid email address.");
              return false;
            }
          } else if (id === "company") {
            const company = normalizeSpaces(el.value);
            if (!el.checkValidity() || !isValidFreeText(company, 2, 120)) {
              setFieldError("company", "Company must be 2–120 characters.");
              return false;
            }
          }
          clearFieldError(id);
          return true;
        }
        // On-blur validation: each field validates when the user leaves it,
        // so problems surface field-by-field instead of only at submit. The
        // submit-time all-at-once pass remains the backstop. Blur only reads
        // and reports — it never preventDefaults or blocks submit.
        for (const id of ["name", "email", "company", "phone"]) {
          const el = document.getElementById(id);
          if (el) el.addEventListener("blur", function () { validateField(id); });
        }
        function setSuccess(m) {
          // textContent + DOM-built <strong> instead of innerHTML so any
          // future contributor extending this with a non-static message
          // can't accidentally introduce XSS.
          if (!ok) return;
          ok.innerHTML = "";
          if (m) {
            const strong = document.createElement("strong");
            strong.textContent = m;
            ok.appendChild(strong);
          }
          if (err) err.textContent = "";
        }
        function setPending(value) {
          pending = value;
          if (submitBtn) {
            submitBtn.disabled = value;
            submitBtn.textContent = value ? "Sending…" : "Send this to Capita";
          }
        }

        // ── Draft persistence ────────────────────────────────────────────
        // Saves the visible fields to localStorage so a prospect who gets
        // interrupted mid-form doesn't lose their typing. Versioned key lets
        // a future schema change invalidate old drafts cleanly. The honeypot
        // (`website`) is never persisted. Writes are debounced and only fire
        // once the user has actually typed something, so an untouched form
        // never creates a draft. Per-field length caps mirror the input
        // maxlengths so a tampered localStorage value can't overflow a field.
        const DRAFT_KEY = "capita-lead-draft-v1";
        const DRAFT_CAPS = { name: 60, email: 254, company: 120, phone: 28, message: 2000 };
        function lsAvailable() {
          try {
            const k = "__capita_probe__";
            window.localStorage.setItem(k, "1");
            window.localStorage.removeItem(k);
            return true;
          } catch (_) {
            return false;
          }
        }
        const STORAGE_OK = lsAvailable();
        function clearDraft() {
          if (!STORAGE_OK) return;
          try {
            window.localStorage.removeItem(DRAFT_KEY);
          } catch (_) {
            /* storage gone mid-session — nothing to clear. */
          }
        }
        function capValue(key, value) {
          const cap = DRAFT_CAPS[key];
          const s = String(value == null ? "" : value);
          return cap ? s.slice(0, cap) : s;
        }
        function readForm() {
          return {
            name: nameEl ? nameEl.value : "",
            email: emailEl ? emailEl.value : "",
            company: companyEl ? companyEl.value : "",
            phone: phoneEl ? phoneEl.value : "",
            package: packageEl ? packageEl.value : "",
            message: msgEl ? msgEl.value : "",
          };
        }
        function hasAnyContent(d) {
          // Only persist once the user has typed something meaningful.
          return Boolean(
            (d.name && d.name.trim()) ||
            (d.email && d.email.trim()) ||
            (d.company && d.company.trim()) ||
            (d.phone && d.phone.trim()) ||
            (d.message && d.message.trim()) ||
            (d.package && d.package !== "not-sure")
          );
        }
        function saveDraft() {
          if (!STORAGE_OK) return;
          const d = readForm();
          if (!hasAnyContent(d)) {
            // Nothing meaningful typed — don't leave an empty draft behind.
            clearDraft();
            return;
          }
          try {
            window.localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
          } catch (_) {
            /* quota / private-mode write failure is non-fatal. */
          }
        }
        let saveTimer = 0;
        function scheduleSave() {
          if (!STORAGE_OK) return;
          window.clearTimeout(saveTimer);
          saveTimer = window.setTimeout(saveDraft, 400);
        }
        // Debounced autosave on input across the visible fields (incl. the
        // country search + package select + message). The honeypot is omitted
        // by construction (it is not in this list).
        for (const el of [nameEl, emailEl, companyEl, phoneEl, msgEl]) {
          if (el) el.addEventListener("input", scheduleSave);
        }
        if (packageEl) packageEl.addEventListener("change", scheduleSave);
        function restoreDraft() {
          if (!STORAGE_OK) return;
          let raw;
          try {
            raw = window.localStorage.getItem(DRAFT_KEY);
          } catch (_) {
            return;
          }
          if (!raw) return;
          let d;
          try {
            d = JSON.parse(raw);
          } catch (_) {
            // Corrupt draft — drop it rather than acting on garbage.
            clearDraft();
            return;
          }
          if (!d || typeof d !== "object") return;
          if (nameEl && d.name) nameEl.value = capValue("name", d.name);
          if (emailEl && d.email) emailEl.value = capValue("email", d.email);
          if (companyEl && d.company) companyEl.value = capValue("company", d.company);
          if (phoneEl && d.phone) phoneEl.value = capValue("phone", d.phone);
          if (msgEl && d.message) msgEl.value = capValue("message", d.message);
          // Restore the package <select> only to a value the option list
          // actually offers, else leave the default.
          if (packageEl && d.package) {
            const has = Array.prototype.some.call(
              packageEl.options,
              function (o) { return o.value === d.package; },
            );
            if (has) packageEl.value = d.package;
          }
        }
        // Restore once the DOM is parsed. The country-picker IIFE runs earlier
        // in this same inline script, so its restore hook already exists; the
        // DOMContentLoaded guard just covers the (already-fired) ready state.
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", restoreDraft, { once: true });
        } else {
          restoreDraft();
        }

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (pending) return;
          setError("");
          clearAllFieldErrors();

          // Honeypot is now `website` (the real Company field claims `company`).
          const hp = form.querySelector('input[name="website"]')?.value;
          if (hp && hp.trim().length) return;

          if (!nameEl || !emailEl) {
            setError("Form is missing required fields.");
            return;
          }
          const name = normalizeSpaces(nameEl.value);
          const email = normalizeSpaces(emailEl.value);
          const company = normalizeSpaces(companyEl ? companyEl.value : "");
          const phone = normalizeSpaces(phoneEl ? phoneEl.value : "");
          const pkg = normalizePackage(packageEl ? packageEl.value : "not-sure");
          const message = safeBodyText(msgEl ? msgEl.value : "");

          // Collect per-field errors first, then short-circuit if any fired
          // so the user sees every problem at once rather than fixing them
          // sequentially.
          let hasFieldError = false;
          if (!nameEl.checkValidity() || !isValidName(name)) {
            setFieldError(
              "name",
              "Name must be 2–60 characters of letters (and spaces, apostrophes, or hyphens).",
            );
            hasFieldError = true;
          }
          if (!emailEl.checkValidity() || !isValidEmail(emailEl)) {
            setFieldError("email", "Enter a valid email address.");
            hasFieldError = true;
          }
          if (company && !isValidFreeText(company, 2, 120)) {
            setFieldError("company", "Company must be 2–120 characters.");
            hasFieldError = true;
          }
          if (!isValidPhoneLocal(phone)) {
            setFieldError(
              "phone",
              "Phone can include +, spaces and dashes, and must be 6 to 15 digits.",
            );
            hasFieldError = true;
          }
          if (hasFieldError) {
            setError("Complete the highlighted fields and try again.");
            // Move focus to the FIRST invalid field (the fields are tested in
            // DOM order above, so the earliest aria-invalid is the first one).
            // The #formError summary is aria-live=assertive (set in markup) so
            // it announces; focusing the field lets a keyboard/AT user start
            // correcting immediately.
            const firstInvalid = form.querySelector('[aria-invalid="true"]');
            if (firstInvalid && typeof firstInvalid.focus === "function") {
              firstInvalid.focus();
            }
            return;
          }

          const payload = { name, email, company, package: pkg, phone, message };

          setPending(true);
          // 30s ceiling so a stalled Formspree edge can't leave the user
          // waiting indefinitely with no signal.
          const ctl = AbortSignal.timeout ? { signal: AbortSignal.timeout(30000) } : {};

          try {
            const res = await fetch(FORMSPREE_ENDPOINT, {
              method: "POST",
              headers: { Accept: "application/json", "Content-Type": "application/json" },
              body: JSON.stringify(payload),
              ...ctl,
            });

            if (res.status === 429) {
              setError("Too many submissions in a short window. Try again in a few minutes or email consulting@capitatech.com.au.");
              return;
            }
            if (!res.ok) {
              setError("Submission failed. Try again or email consulting@capitatech.com.au.");
              return;
            }

            form.reset();
            clearAllFieldErrors();
            // The submitted draft is now stale — drop it so a returning
            // prospect doesn't get last lead's data restored on next visit.
            clearDraft();
            setSuccess("Received. You will hear from us within two business days.");
            // Scroll the confirmation into the middle of the viewport so it
            // is never hidden behind a mobile thumb / on-screen keyboard.
            if (ok && typeof ok.scrollIntoView === "function") {
              const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
              ).matches;
              ok.scrollIntoView({
                behavior: reducedMotion ? "auto" : "smooth",
                block: "center",
              });
            }
          } catch (caught) {
            const isAbort = caught && caught.name === "AbortError";
            setError(
              isAbort
                ? "Submission timed out. Try again or email consulting@capitatech.com.au."
                : "Network error. Try again or email consulting@capitatech.com.au."
            );
          } finally {
            setPending(false);
          }
        });
      })();

      // 6. Package pre-fill — package cards carry data-package on their
      // CTA so a click sets the contact form's <select> to the matching
      // slug. URL fragments like `#contact?package=om-and-a` set the
      // value the same way (lets sales send shareable deep links). The
      // slug list mirrors PACKAGE_SLUGS in the form handler; an unknown
      // value falls back to "not-sure" silently.
      (function initPackagePrefill() {
        const select = document.getElementById("package");
        if (!select) return;
        const allowed = new Set([
          "not-sure", "om-and-a", "diagnosis", "roadmap", "measurement", "bespoke",
        ]);

        function apply(slug) {
          if (!slug || !allowed.has(slug)) return;
          select.value = slug;
        }

        // Click-handler: any anchor with [data-package] sets the select
        // before the browser scrolls to #contact, so by the time the
        // contact section is on screen the option is already chosen.
        document.querySelectorAll("a[data-package]").forEach(function (a) {
          a.addEventListener("click", function () {
            apply(a.getAttribute("data-package"));
          });
        });

        // URL fragment with embedded query — Astro single-page anchors
        // mean `location.hash` carries the package= segment when
        // shareable links land. Parse on initial load and on subsequent
        // hashchange so back/forward nav re-applies the selection.
        function fromHash() {
          const raw = String(location.hash || "");
          const q = raw.indexOf("?");
          if (q < 0) return;
          const search = new URLSearchParams(raw.slice(q + 1));
          const slug = search.get("package");
          if (slug) apply(slug);
        }
        fromHash();
        window.addEventListener("hashchange", fromHash);
      })();
    </script>
  </body>
</html>
